# name: benchmark/micro/maintenance/checkpoint_noop.benchmark
# description: Run a warm CHECKPOINT on an already-compacted 50-table lake, where every maintenance step is a no-op
# group: [maintenance]

name Checkpoint Noop
group micro
subgroup maintenance

require ducklake

require parquet

argument tables 50

cache_file ckpt_${tables}_ready.marker

# Each table gets three 100-row files and 5 inlined rows; CHECKPOINT flushes and merges them into one file per table
load
EXPORT DATABASE '${BENCHMARK_DIR}/ckpt_${tables}_gen';
COPY (SELECT stmt FROM (
SELECT 0 AS o, i, 'CREATE TABLE lake.t' || i || ' (id BIGINT, v VARCHAR); COMMIT; BEGIN;' AS stmt
FROM range(${tables}) r(i)
UNION ALL
SELECT 1 + j, i, 'INSERT INTO lake.t' || i || ' SELECT r, ''v'' || r FROM range(100) t(r);'
|| CASE WHEN i = ${tables} - 1 THEN ' COMMIT; BEGIN;' ELSE '' END
FROM range(${tables}) r(i), range(3) s(j)
UNION ALL
SELECT 4, i, 'INSERT INTO lake.t' || i || ' SELECT r, ''w'' || r FROM range(5) t(r);'
|| CASE WHEN i = ${tables} - 1 THEN ' COMMIT; BEGIN;' ELSE '' END
FROM range(${tables}) r(i)
) ORDER BY o, i) TO '${BENCHMARK_DIR}/ckpt_${tables}_gen/schema.sql' (HEADER false, QUOTE '');
ATTACH 'ducklake:${BENCHMARK_DIR}/ckpt_${tables}.db' AS lake (DATA_PATH '${BENCHMARK_DIR}/ckpt_${tables}_files');
IMPORT DATABASE '${BENCHMARK_DIR}/ckpt_${tables}_gen';
CHECKPOINT lake;
CALL ducklake_cleanup_old_files('lake', cleanup_all => true);
DETACH lake;
COPY (SELECT 1) TO '${BENCHMARK_DIR}/ckpt_${tables}_ready.marker' (FORMAT CSV);
ATTACH 'ducklake:${BENCHMARK_DIR}/ckpt_${tables}.db' AS lake;
SELECT CASE WHEN (SELECT count(*) FROM glob('${BENCHMARK_DIR}/ckpt_${tables}_files/**')) <> ${tables}
OR (SELECT count(*) <> ${tables} OR sum(record_count) <> ${tables} * 305
FROM __ducklake_metadata_lake.ducklake_data_file WHERE end_snapshot IS NULL)
THEN error('the lake is not fully compacted') END;
SET VARIABLE ckpt_snapshots = (SELECT {'n': count(*), 'last': max(snapshot_id)} FROM lake.snapshots());

reload
ATTACH 'ducklake:${BENCHMARK_DIR}/ckpt_${tables}.db' AS lake;
SELECT CASE WHEN (SELECT count(*) FROM glob('${BENCHMARK_DIR}/ckpt_${tables}_files/**')) <> ${tables}
OR (SELECT count(*) <> ${tables} OR sum(record_count) <> ${tables} * 305
FROM __ducklake_metadata_lake.ducklake_data_file WHERE end_snapshot IS NULL)
THEN error('the lake is not fully compacted') END;
SET VARIABLE ckpt_snapshots = (SELECT {'n': count(*), 'last': max(snapshot_id)} FROM lake.snapshots());

# The warmup run absorbs the cold first CHECKPOINT after the attach
run
CHECKPOINT lake;

# CHECKPOINT returns no rows, so fail loudly if it committed, expired or deleted anything
cleanup
SELECT CASE WHEN (SELECT {'n': count(*), 'last': max(snapshot_id)} FROM lake.snapshots())
IS DISTINCT FROM getvariable('ckpt_snapshots')
OR (SELECT count(*) FROM glob('${BENCHMARK_DIR}/ckpt_${tables}_files/**')) <> ${tables}
THEN error('checkpoint was not a no-op') END;
