# name: benchmark/micro/read/multi_column_pruning_many_files.benchmark
# description: Count the rows of a filter on 8 columns that 1634 of 2000 files pass through the metadata stats
# group: [read]

name Multi Column Pruning Many Files
group micro
subgroup read

require ducklake

require parquet

include benchmark/micro/fixtures/wide_files.benchmark.in

run
SELECT count(*) FROM lake.t
WHERE c1 >= 600 AND c2 <= 11000 AND c3 >= 3 AND c4 <= 23000 AND c5 >= 5 AND c6 <= 35000 AND c7 >= 7 AND c8 <= 47000;

result I
4819
