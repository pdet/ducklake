# name: benchmark/micro/read/or_pruning_many_files.benchmark
# description: One query of 20 branches whose filters are cross-column OR trees of 2 to 63 leaves over ~4096 files
# group: [read]

name OR Pruning Many Files
group micro
subgroup read

require ducklake

require parquet

include benchmark/micro/fixtures/many_files.benchmark.in

# Disjunctions are pruned file by file; q20 is the largest flat OR that fits the 64-node walk of the pruning
run benchmark/micro/queries/or_pruning.sql

