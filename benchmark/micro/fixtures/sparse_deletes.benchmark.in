# name: benchmark/micro/fixtures/sparse_deletes.benchmark.in
# description: Lake with a 4096-file table where 8 files have 60% of their rows deleted and 100 files one row each
# group: [fixtures]

argument lake sparse_deletes_v1

cache_file ${lake}_ready.marker

# Row group size 2048 and a 4KB target give one file per 2048 rows
load
@create ${lake}_pristine
@attach ${lake}_pristine AS lake (DATA_PATH '${BENCHMARK_DIR}/${lake}_files')
CALL lake.set_option('data_inlining_row_limit', 0);
CREATE TABLE lake.events (id BIGINT, v VARCHAR);
CALL lake.set_option('parquet_row_group_size', 2048, table_name => 'events');
SET ducklake_target_file_size = '4KB';
INSERT INTO lake.events SELECT i, 'v' || i FROM range(4096 * 2048) t(i);
RESET ducklake_target_file_size;
DELETE FROM lake.events WHERE id < 8 * 2048 AND id % 10 < 6;
DELETE FROM lake.events WHERE id >= 8 * 2048 AND id < 108 * 2048 AND id % 2048 = 0;
SELECT CASE WHEN (SELECT count(*) FROM ducklake_list_files('lake', 'events')) <> 4096
OR (SELECT count(*) FROM __ducklake_metadata_lake.ducklake_delete_file WHERE end_snapshot IS NULL) <> 108
THEN error('expected 4096 files, 108 of them with deletes') END;
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true);
DETACH lake;
COPY (SELECT count(*) FROM glob('${BENCHMARK_DIR}/${lake}_files/**'))
TO '${BENCHMARK_DIR}/${lake}_filecount.csv' (FORMAT CSV, HEADER false);
@seal ${lake}_pristine
COPY (SELECT 1) TO '${BENCHMARK_DIR}/${lake}_ready.marker' (FORMAT CSV);
DETACH DATABASE IF EXISTS lake;
@copy ${lake}_pristine TO ${work}
@attach ${work} AS lake
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true);
SELECT CASE WHEN (SELECT count(*) FROM glob('${BENCHMARK_DIR}/${lake}_files/**'))
<> (SELECT column0 FROM read_csv('${BENCHMARK_DIR}/${lake}_filecount.csv', header = false))
THEN error('the fixture files were not restored') END;

include benchmark/micro/fixtures/restore_reload.benchmark.in
