# name: benchmark/micro/fixtures/many_files.benchmark.in
# description: Read-only lake with ~4096 small files, ~1000 files scheduled for deletion and 2000 orphan files
# group: [fixtures]

cache_file many_files_ready.marker

# events holds disjoint id/ts/s ranges per 2048-row file; the dropped churn table leaves its files scheduled
load
ATTACH 'ducklake:${BENCHMARK_DIR}/many_files.db' AS lake (DATA_PATH '${BENCHMARK_DIR}/many_files_data');
CREATE TABLE lake.events (id BIGINT, ts TIMESTAMP, grp INTEGER, val DOUBLE, s VARCHAR);
CREATE TABLE lake.churn (id BIGINT);
CALL lake.set_option('parquet_row_group_size', 2048, table_name => 'events');
CALL lake.set_option('parquet_row_group_size', 2048, table_name => 'churn');
SET ducklake_target_file_size = '4KB';
INSERT INTO lake.events
SELECT i, TIMESTAMP '2024-01-01' + INTERVAL (i) SECOND, i % 100, i * 0.5, printf('v%07d', i)
FROM range(4096 * 2048) t(i);
INSERT INTO lake.churn SELECT i FROM range(1000 * 2048) t(i);
RESET ducklake_target_file_size;
DROP TABLE lake.churn;
CALL ducklake_expire_snapshots('lake', older_than => TIMESTAMPTZ '2999-01-01');
SELECT CASE WHEN (SELECT count(*) FROM ducklake_list_files('lake', 'events')) < 4000
THEN error('events must consist of ~4096 small files') END;
DETACH lake;
COPY (SELECT i AS p, i AS v FROM range(2000) t(i))
TO '${BENCHMARK_DIR}/many_files_data/orphans' (FORMAT PARQUET, PARTITION_BY (p));
COPY (SELECT 1) TO '${BENCHMARK_DIR}/many_files_ready.marker' (FORMAT CSV);
ATTACH 'ducklake:${BENCHMARK_DIR}/many_files.db' AS lake (READ_ONLY);

reload
ATTACH 'ducklake:${BENCHMARK_DIR}/many_files.db' AS lake (READ_ONLY);
