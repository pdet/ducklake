# name: benchmark/micro/write/insert_commits_retyped_column.benchmark
# description: Retype a FLOAT column stored in ~1024 files to DOUBLE, then twenty single-row commits
# group: [write]

name Insert Commits Retyped Column
group micro
subgroup write

require ducklake

require parquet

argument work float_files_work

include benchmark/micro/fixtures/float_files.benchmark.in

include benchmark/micro/fixtures/restore_cleanup.benchmark.in

# The retype leaves the bounds of v unknown, so every commit with a value of v checks the live files
run
ALTER TABLE lake.events ALTER COLUMN v TYPE DOUBLE;
INSERT INTO lake.events VALUES (-1, 0.5);
INSERT INTO lake.events VALUES (-2, 0.5);
INSERT INTO lake.events VALUES (-3, 0.5);
INSERT INTO lake.events VALUES (-4, 0.5);
INSERT INTO lake.events VALUES (-5, 0.5);
INSERT INTO lake.events VALUES (-6, 0.5);
INSERT INTO lake.events VALUES (-7, 0.5);
INSERT INTO lake.events VALUES (-8, 0.5);
INSERT INTO lake.events VALUES (-9, 0.5);
INSERT INTO lake.events VALUES (-10, 0.5);
INSERT INTO lake.events VALUES (-11, 0.5);
INSERT INTO lake.events VALUES (-12, 0.5);
INSERT INTO lake.events VALUES (-13, 0.5);
INSERT INTO lake.events VALUES (-14, 0.5);
INSERT INTO lake.events VALUES (-15, 0.5);
INSERT INTO lake.events VALUES (-16, 0.5);
INSERT INTO lake.events VALUES (-17, 0.5);
INSERT INTO lake.events VALUES (-18, 0.5);
INSERT INTO lake.events VALUES (-19, 0.5);
INSERT INTO lake.events VALUES (-20, 0.5);

# A missed reset fails the retype check or doubles the new rows
result_query III
SELECT (SELECT data_type FROM duckdb_columns() WHERE database_name = 'lake' AND column_name = 'v'),
(SELECT count(*) FROM lake.events WHERE id < 0), (SELECT count(*) FROM lake.events)
----
DOUBLE	20	2097172
