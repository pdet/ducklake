# name: benchmark/micro/ingest/add_files_not_null.benchmark
# description: Add 1000 small parquet files to a table whose 20 columns are all NOT NULL
# group: [ingest]

argument file_count 1000

argument lake add_files_not_null_${file_count}

argument work add_files_not_null_${file_count}_work

name DuckLake Add Files Not Null
group micro
subgroup ingest

require ducklake

require parquet

cache_file ${lake}_ready.marker

# One single-row file per source row, checked against the NOT NULL constraint of every column
load
CREATE TABLE src AS SELECT
i::INTEGER AS c01, (i + 1)::INTEGER AS c02, (i + 2)::INTEGER AS c03, (i + 3)::INTEGER AS c04,
(i + 4)::INTEGER AS c05, (i + 5)::INTEGER AS c06, (i + 6)::INTEGER AS c07, (i + 7)::INTEGER AS c08,
(i + 8)::INTEGER AS c09, (i + 9)::INTEGER AS c10, (i + 10)::INTEGER AS c11, (i + 11)::INTEGER AS c12,
(i + 12)::INTEGER AS c13, (i + 13)::INTEGER AS c14, (i + 14)::INTEGER AS c15, (i + 15)::INTEGER AS c16,
(i + 16)::INTEGER AS c17, (i + 17)::INTEGER AS c18, (i + 18)::INTEGER AS c19, (i + 19)::INTEGER AS c20
FROM range(${file_count}) t(i);
COPY src TO '${BENCHMARK_DIR}/${lake}_source'
(FORMAT PARQUET, PARTITION_BY (c01), WRITE_PARTITION_COLUMNS true, OVERWRITE);
DROP TABLE src;
@create ${lake}_pristine
@attach ${lake}_pristine AS lake (DATA_PATH '${BENCHMARK_DIR}/${lake}_files')
CREATE TABLE lake.not_null_files (
c01 INTEGER NOT NULL, c02 INTEGER NOT NULL, c03 INTEGER NOT NULL, c04 INTEGER NOT NULL, c05 INTEGER NOT NULL,
c06 INTEGER NOT NULL, c07 INTEGER NOT NULL, c08 INTEGER NOT NULL, c09 INTEGER NOT NULL, c10 INTEGER NOT NULL,
c11 INTEGER NOT NULL, c12 INTEGER NOT NULL, c13 INTEGER NOT NULL, c14 INTEGER NOT NULL, c15 INTEGER NOT NULL,
c16 INTEGER NOT NULL, c17 INTEGER NOT NULL, c18 INTEGER NOT NULL, c19 INTEGER NOT NULL, c20 INTEGER NOT NULL
);
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true);
DETACH lake;
COPY (SELECT count(*) FROM glob('${BENCHMARK_DIR}/${lake}_files/**'))
TO '${BENCHMARK_DIR}/${lake}_filecount.csv' (FORMAT CSV, HEADER false);
@seal ${lake}_pristine
COPY (SELECT 1) TO '${BENCHMARK_DIR}/${lake}_ready.marker' (FORMAT CSV);
DETACH DATABASE IF EXISTS lake;
@copy ${lake}_pristine TO ${work}
@attach ${work} AS lake
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true);
SELECT CASE WHEN (SELECT count(*) FROM glob('${BENCHMARK_DIR}/${lake}_files/**'))
<> (SELECT column0 FROM read_csv('${BENCHMARK_DIR}/${lake}_filecount.csv', header = false))
THEN error('the fixture files were not restored') END;

include benchmark/micro/fixtures/restore_reload.benchmark.in

run
CALL ducklake_add_data_files('lake', 'not_null_files', '${BENCHMARK_DIR}/${lake}_source/**/*.parquet');

include benchmark/micro/fixtures/restore_cleanup.benchmark.in

# A reset that misses re-registers the same files and doubles the row count
result_query II
SELECT count(*), sum(c20) = ${file_count} * (${file_count} - 1) // 2 + 19 * ${file_count} FROM lake.not_null_files
----
${file_count}	true
