# name: test/sql/migration/v11_dev1_to_v11.test
# description: a 1.1-dev1 catalog stays at 1.1-dev1 on a plain attach and migrates to 1.1 with AUTOMATIC_MIGRATION
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v11_dev1_to_v11_files', DUCKLAKE_VERSION '1.1-dev1')

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
1.1-dev1

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v11_dev1_to_v11_files')

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
1.1-dev1

statement ok
DETACH dl

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v11_dev1_to_v11_files', DUCKLAKE_VERSION '1.1')
----
DuckLake catalog version mismatch: catalog version is 1.1-dev1, but the extension requires version 1.1

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v11_dev1_to_v11_files', AUTOMATIC_MIGRATION TRUE)

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
1.1

query I
SELECT * FROM dl.t
----
42

statement ok
DETACH dl

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v11_dev1_to_v11_files', DUCKLAKE_VERSION '1.1-dev1')
----
Cannot downgrade
