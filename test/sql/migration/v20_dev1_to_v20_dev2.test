# name: test/sql/migration/v20_dev1_to_v20_dev2.test
# description: a 2.0-dev1 catalog is only attached after its migration to 2.0-dev2
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v20_dev1_to_v20_dev2_files', METADATA_CATALOG 'meta', DUCKLAKE_VERSION '1.1')

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

# simulate a catalog created by a 2.0-dev1 build
statement ok
CREATE TABLE meta.ducklake_snapshot_tag(tag_name VARCHAR, snapshot_id BIGINT, begin_snapshot BIGINT, end_snapshot BIGINT)

statement ok
UPDATE meta.ducklake_metadata SET value = '2.0-dev1' WHERE key = 'version'

statement ok
DETACH dl

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v20_dev1_to_v20_dev2_files')
----
DuckLake catalog version mismatch: catalog version is 2.0-dev1, but the extension requires version 2.0-dev2.

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v20_dev1_to_v20_dev2_files', DUCKLAKE_VERSION '2.0-dev1')
----
ducklake_version must be '1.0', '1.1' or '2.0-dev2', got '2.0-dev1'

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v20_dev1_to_v20_dev2_files', METADATA_CATALOG 'meta', AUTOMATIC_MIGRATION TRUE)

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
2.0-dev2

query IIIIII
SELECT branch_id, branch_name, fork_branch_id, fork_snapshot_id, begin_snapshot, end_snapshot FROM meta.ducklake_branch
----
0	main	NULL	NULL	0	NULL

# existing snapshots are backfilled to main
query II
SELECT snapshot_id, branch_id FROM meta.ducklake_snapshot ORDER BY snapshot_id
----
0	0
1	0

query I
SELECT COUNT(*) FROM meta.ducklake_end_override
----
0

query I
SELECT COUNT(*) FROM meta.ducklake_snapshot_remap
----
0

query I
SELECT * FROM dl.t
----
42

# commits after the migration land on main
statement ok
INSERT INTO dl.t VALUES (43)

query II
SELECT snapshot_id, branch_id FROM meta.ducklake_snapshot ORDER BY snapshot_id
----
0	0
1	0
2	0

statement ok
DETACH dl
