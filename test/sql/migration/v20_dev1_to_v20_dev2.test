# name: test/sql/migration/v20_dev1_to_v20_dev2.test
# description: a 2.0-dev1 catalog is attached only after its migration to 2.0-dev2, which gives its tags an expiry time
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v20_dev1_to_v20_dev2_files', METADATA_CATALOG 'meta', DUCKLAKE_VERSION '1.1')

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

# a 2.0-dev1 catalog with a tag, as the builds before 2.0-dev2 write it
statement ok
CREATE TABLE meta.ducklake_snapshot_tag(tag_name VARCHAR, snapshot_id BIGINT, begin_snapshot BIGINT, end_snapshot BIGINT)

statement ok
INSERT INTO meta.ducklake_snapshot_tag VALUES ('release', 1, 1, NULL)

statement ok
UPDATE meta.ducklake_metadata SET value = '2.0-dev1' WHERE key = 'version'

statement ok
DETACH dl

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v20_dev1_to_v20_dev2_files', METADATA_CATALOG 'meta')
----
catalog version is 2.0-dev1, but the extension requires version 2.0-dev2

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v20_dev1_to_v20_dev2_files', METADATA_CATALOG 'meta', DUCKLAKE_VERSION '2.0-dev1')
----
ducklake_version must be '1.0', '1.1' or '2.0-dev2', got '2.0-dev1'

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v20_dev1_to_v20_dev2_files', METADATA_CATALOG 'meta', AUTOMATIC_MIGRATION TRUE)

query I
SELECT value FROM dl.options() WHERE option_name = 'version'
----
2.0-dev2

# the tag keeps its snapshot and gets no expiry time
query III
SELECT tag_name, snapshot_id, expires_at IS NULL FROM ducklake_tags('dl')
----
release	1	true

query I
SELECT * FROM dl.t AT (VERSION => 'release')
----
42

statement ok
CALL ducklake_set_tag_expiry('dl', 'release', TIMESTAMPTZ '2100-01-01 00:00:00+00')

query I
SELECT expires_at = TIMESTAMPTZ '2100-01-01 00:00:00+00' FROM ducklake_tags('dl')
----
true
