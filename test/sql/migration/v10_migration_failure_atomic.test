# name: test/sql/migration/v10_migration_failure_atomic.test
# description: a failure late in the v1.0 to v1.1-dev1 migration also undoes the inlined column renames
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/v10_migration_failure_atomic.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/v10_migration_failure_atomic', DUCKLAKE_VERSION '1.0')

statement ok
CREATE TABLE dl.t(i INTEGER);

statement ok
INSERT INTO dl.t VALUES (1), (2);

# the table the migration creates last already exists, so the migration fails after the renames
statement ok
CREATE TABLE __ducklake_metadata_dl.ducklake_view_column_tag(view_id BIGINT);

statement ok
DETACH dl

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (AUTOMATIC_MIGRATION TRUE)
----
Failed to migrate DuckLake from v1.0 to v1.1-dev1

# the catalog is still a readable v1.0 catalog
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl

query I
SELECT value FROM __ducklake_metadata_dl.ducklake_metadata WHERE key = 'version'
----
1.0

query I
SELECT i FROM dl.t ORDER BY i
----
1
2

statement ok
DROP TABLE __ducklake_metadata_dl.ducklake_view_column_tag

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (AUTOMATIC_MIGRATION TRUE)

query I
SELECT value FROM __ducklake_metadata_dl.ducklake_metadata WHERE key = 'version'
----
1.1-dev1

query I
SELECT i FROM dl.t ORDER BY i
----
1
2

statement ok
DETACH dl
