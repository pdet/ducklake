# name: test/sql/migration/inlined_column_rename_collision_atomic.test
# description: a collision in one inlined table aborts the migration before any inlined table is renamed
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/inlined_column_rename_collision_atomic.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/inlined_column_rename_collision_atomic', DUCKLAKE_VERSION '1.0')

statement ok
CREATE TABLE dl.a(i INTEGER);

statement ok
INSERT INTO dl.a VALUES (1), (2);

# legal on v1.0 where only row_id, begin_snapshot and end_snapshot were reserved
statement ok
CREATE TABLE dl.b(_ducklake_begin_snapshot INTEGER, v INTEGER);

statement ok
INSERT INTO dl.b VALUES (10, 20);

statement ok
CREATE TABLE dl.c(j INTEGER);

statement ok
INSERT INTO dl.c VALUES (3);

statement ok
DETACH dl

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (AUTOMATIC_MIGRATION TRUE)
----
table "b" has a column "_ducklake_begin_snapshot" colliding with the renamed metadata column

# nothing was renamed, so every table still reads at v1.0
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl

query I
SELECT value FROM __ducklake_metadata_dl.ducklake_metadata WHERE key = 'version'
----
1.0

query I
SELECT i FROM dl.a ORDER BY i
----
1
2

query II
SELECT * FROM dl.b
----
10	20

query I
SELECT j FROM dl.c
----
3

statement ok
DETACH dl
