# name: test/sql/migration/dev1_plain_attach_migration_failure.test
# description: a plain attach of a 1.1-dev1 catalog whose schema additions cannot be applied warns and still loads
# group: [migration]

require ducklake

require parquet

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{TEST_DIR}/dev1_migration_failure.db' AS dl
(DATA_PATH '{DATA_PATH}/dev1_migration_failure', DUCKLAKE_VERSION '1.1-dev1')

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

statement ok
DETACH dl

# a missing addition triggers the migration, which fails because the metadata table is not a base table
statement ok
ATTACH '{TEST_DIR}/dev1_migration_failure.db' AS meta

statement ok
ALTER TABLE meta.ducklake_delete_file DROP COLUMN row_group_count

statement ok
ALTER TABLE meta.ducklake_metadata RENAME TO ducklake_metadata_table

statement ok
CREATE VIEW meta.ducklake_metadata AS SELECT * FROM ducklake_metadata_table

statement ok
DETACH meta

statement ok
CALL enable_logging(level = 'WARNING')

statement ok
ATTACH 'ducklake:{TEST_DIR}/dev1_migration_failure.db' AS dl (DUCKLAKE_VERSION '1.1-dev1')

query I
SELECT * FROM dl.t
----
42

query I
SELECT count(*) FROM duckdb_logs WHERE message LIKE '%could not apply the v1.1-dev1 schema additions%'
----
1

statement ok
CALL disable_logging()

statement ok
DETACH dl
