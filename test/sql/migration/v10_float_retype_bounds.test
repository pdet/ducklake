# name: test/sql/migration/v10_float_retype_bounds.test
# description: the v1.1 migration rewrites the FLOAT bounds that DuckDB 1.5.6 kept for columns retyped to DOUBLE
# group: [migration]

require ducklake

require parquet

# written by DuckDB 1.5.6, t, s.a, u and i held a FLOAT 0.1 before their retype to DOUBLE
# t got 0.05 and 0.3 after the retype, u got 0.05 in the transaction of its retype, i has inlined rows
# c was an INTEGER 16777217, and got a FLOAT 0.1 in one transaction with its retypes to FLOAT and DOUBLE
# d got an INTEGER 16777217 in the transaction of its retype to FLOAT, e was created as a FLOAT 0.1 by CREATE TABLE AS
unzip data/old_ducklake/float_retype_bounds.db.gz {TEST_DIR}/v10_float_retype_bounds.db

statement ok
ATTACH 'ducklake:{TEST_DIR}/v10_float_retype_bounds.db' AS lake (DATA_PATH 'data/old_ducklake/float_retype_bounds/', OVERRIDE_DATA_PATH TRUE, METADATA_CATALOG 'meta', DUCKLAKE_VERSION '1.1-dev1', AUTOMATIC_MIGRATION TRUE)

query I
SELECT count(*) FROM lake.t WHERE v > 0.1
----
2

query I
SELECT count(*) FROM lake.t WHERE v > 0.1 AND v < 0.2
----
1

query I
SELECT count(*) FROM lake.s WHERE s.a > 0.1
----
1

query I
SELECT count(*) FROM lake.u WHERE v > 0.1
----
1

query I
SELECT count(*) FROM lake.i WHERE v > 0.1
----
1

query I
SELECT count(*) FROM lake.c WHERE v > 0.1 AND v < 0.2
----
1

query I
SELECT count(*) FROM lake.c WHERE v = 16777217
----
1

query I
SELECT count(*) FROM lake.d WHERE v = 16777217
----
1

query I
SELECT count(*) FROM lake.e WHERE v > 0.1
----
1

# min and max answered from the table bounds are exact
query I
SELECT max(v) FROM lake.e
----
0.10000000149011612

query II
SELECT min(v), max(v) FROM lake.d
----
16777217.0	16777217.0

query II
SELECT min(v), max(v) FROM lake.t
----
0.05	0.3

query II
SELECT min(v), max(v) FROM lake.i
----
0.10000000149011612	0.10000000149011612

query II
SELECT min(v), max(v) FROM lake.c
----
0.10000000149011612	16777217.0

# FLOAT files get the DOUBLE value of their bounds, files of a commit that changed the type lose them
query IIII
SELECT tbl.table_name, stats.data_file_id, stats.min_value, stats.max_value
FROM meta.ducklake_file_column_stats stats
JOIN meta.ducklake_table tbl USING (table_id)
ORDER BY ALL
----
c	6	16777217	16777217
c	7	NULL	NULL
d	8	NULL	NULL
e	9	0.10000000149011612	0.10000000149011612
s	2	0.10000000149011612	0.10000000149011612
t	0	0.10000000149011612	0.10000000149011612
t	1	0.05	0.3
u	3	NULL	NULL
u	4	NULL	NULL

# table bounds stay only where every value was written while the column was FLOAT
query III
SELECT tbl.table_name, stats.min_value, stats.max_value
FROM meta.ducklake_table_column_stats stats
JOIN meta.ducklake_table tbl USING (table_id)
ORDER BY ALL
----
c	NULL	NULL
d	NULL	NULL
e	0.10000000149011612	0.10000000149011612
i	0.10000000149011612	0.10000000149011612
s	0.10000000149011612	0.10000000149011612
t	NULL	NULL
u	NULL	NULL

statement ok
DETACH lake

# a migrated catalog keeps its bounds
statement ok
ATTACH 'ducklake:{TEST_DIR}/v10_float_retype_bounds.db' AS lake (DATA_PATH 'data/old_ducklake/float_retype_bounds/', OVERRIDE_DATA_PATH TRUE, METADATA_CATALOG 'meta', DUCKLAKE_VERSION '1.1-dev1', AUTOMATIC_MIGRATION TRUE)

query II
SELECT min_value, max_value FROM meta.ducklake_file_column_stats WHERE data_file_id = 0
----
0.10000000149011612	0.10000000149011612

query I
SELECT count(*) FROM lake.t WHERE v > 0.1 AND v < 0.2
----
1

statement ok
DETACH lake
