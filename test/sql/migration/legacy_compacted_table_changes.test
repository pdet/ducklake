# name: test/sql/migration/legacy_compacted_table_changes.test
# description: Snapshots of an old DuckLake with compacted_table changes can still be listed
# group: [migration]

require ducklake

require parquet

unzip data/old_ducklake/compacted_files.db.gz {TEST_DIR}/legacy_compacted_table_changes.db

statement ok
ATTACH 'ducklake:{TEST_DIR}/legacy_compacted_table_changes.db' AS ducklake (DATA_PATH '{TEST_DIR}/legacy_compacted_table_changes_files', OVERRIDE_DATA_PATH TRUE, AUTOMATIC_MIGRATION TRUE)

# snapshot 8 compacted table 1 with the legacy compacted_table change type
query II
SELECT snapshot_id, changes FROM ducklake.snapshots() WHERE snapshot_id IN (6, 7, 9) ORDER BY snapshot_id
----
6	{tables_inserted_into=[1]}
7	{flushed_inlined=[1]}
9	{inlined_insert=[1]}

query I
SELECT count(*) FROM ducklake.snapshots() WHERE snapshot_id = 8
----
1

# FIXME: the changes of snapshot 8 leave out the compaction, see https://github.com/pdet/ducklake_internal/issues/132
mode skip

query I
SELECT len(changes) > 0 FROM ducklake.snapshots() WHERE snapshot_id = 8
----
true

mode unskip
