# name: test/sql/migration/dev_rerun_skips_ddl.test
# description: an unchanged catalog skips migration DDL and a missing addition is restored
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/dev_rerun_skips_ddl.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/dev_rerun_skips_ddl', METADATA_CATALOG 'meta')

statement ok
CREATE TABLE ducklake.t(i INTEGER)

statement ok
INSERT INTO ducklake.t VALUES (42)

statement ok
DETACH ducklake

statement ok
CALL enable_logging('DuckLakeMetadata')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (METADATA_CATALOG 'meta')

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (METADATA_CATALOG 'meta', AUTOMATIC_MIGRATION TRUE)

query I
SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query ILIKE '%ALTER TABLE%' OR query ILIKE '%CREATE TABLE%' OR query ILIKE '%UPDATE%ducklake_metadata%'
----
0

statement ok
ALTER TABLE meta.ducklake_delete_file DROP COLUMN row_group_count

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (METADATA_CATALOG 'meta')

statement ok
SELECT row_group_count FROM meta.ducklake_delete_file
