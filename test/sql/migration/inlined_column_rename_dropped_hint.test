# name: test/sql/migration/inlined_column_rename_dropped_hint.test
# description: a collision in the inlined data of a dropped table asks to expire its snapshots before migrating
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/inlined_column_rename_dropped_hint.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/inlined_column_rename_dropped_hint', DUCKLAKE_VERSION '1.0')

# legal on v1.0 where only row_id, begin_snapshot and end_snapshot were reserved
statement ok
CREATE TABLE dl.d(_ducklake_row_id INTEGER, v INTEGER);

statement ok
INSERT INTO dl.d VALUES (1, 2);

statement ok
DROP TABLE dl.d;

statement ok
CREATE TABLE dl.t(i INTEGER);

statement ok
INSERT INTO dl.t VALUES (42);

statement ok
DETACH dl

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (AUTOMATIC_MIGRATION TRUE)
----
the dropped table "d" has a column "_ducklake_row_id" colliding with the renamed metadata column. Expire the snapshots in which the table exists with ducklake_expire_snapshots() before migrating

# following the advice makes the migration succeed
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl

statement ok
CALL ducklake_expire_snapshots('dl', older_than => now())

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (AUTOMATIC_MIGRATION TRUE)

query I
SELECT value FROM __ducklake_metadata_dl.ducklake_metadata WHERE key = 'version'
----
1.1-dev1

query I
SELECT i FROM dl.t
----
42

statement ok
DETACH dl
