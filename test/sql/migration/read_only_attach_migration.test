# name: test/sql/migration/read_only_attach_migration.test
# description: read only and failing attaches leave the catalog unchanged
# group: [migration]

require ducklake

test-env DUCKLAKE_CONNECTION {TEST_DIR}/read_only_attach_migration.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/read_only_attach_migration', DUCKLAKE_VERSION '1.0')

statement ok
CREATE TABLE ducklake.t(i INTEGER);

statement ok
DETACH ducklake

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (READ_ONLY, AUTOMATIC_MIGRATION TRUE)
----
Cannot migrate DuckLake catalog version 1.0

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (SNAPSHOT_VERSION 1, AUTOMATIC_MIGRATION TRUE)
----
Cannot migrate DuckLake catalog version 1.0

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (AUTOMATIC_MIGRATION TRUE, ENCRYPTED TRUE)
----
the database is not encrypted

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DUCKLAKE_VERSION '1.0')

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (AUTOMATIC_MIGRATION TRUE)

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (READ_ONLY, AUTOMATIC_MIGRATION TRUE)

statement ok
DETACH ducklake

statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS meta

statement ok
ALTER TABLE meta.ducklake_delete_file DROP COLUMN row_group_count

statement ok
DETACH meta

statement ok
CALL enable_logging('DuckLakeMetadata')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (SNAPSHOT_VERSION 1)

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (SNAPSHOT_VERSION 1, AUTOMATIC_MIGRATION TRUE)

statement ok
DETACH ducklake

query I
SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query ILIKE '%ALTER TABLE%' OR query ILIKE '%CREATE TABLE%' OR query ILIKE '%UPDATE%ducklake_metadata%'
----
0

statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS meta

statement error
SELECT row_group_count FROM meta.ducklake_delete_file
----
row_group_count

statement ok
DETACH meta
