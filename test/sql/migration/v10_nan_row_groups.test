# name: test/sql/migration/v10_nan_row_groups.test
# description: the v1.1 migration forgets the NaN flags that DuckDB 1.5.6 took from the last row group of a file
# group: [migration]

require ducklake

require parquet

# written by DuckDB 1.5.6, the file has two row groups and a NaN in the first one, its NaN flags are false
unzip data/old_ducklake/nan_row_groups.db.gz {TEST_DIR}/v10_nan_row_groups.db

statement ok
ATTACH 'ducklake:{TEST_DIR}/v10_nan_row_groups.db' AS lake (DATA_PATH 'data/old_ducklake/nan_row_groups/', OVERRIDE_DATA_PATH TRUE, METADATA_CATALOG 'meta', DUCKLAKE_VERSION '1.1-dev1', AUTOMATIC_MIGRATION TRUE)

query IIII
SELECT (SELECT count(*) FROM lake.t WHERE d = 'NaN'), (SELECT count(*) FROM lake.t WHERE f > 5000), (SELECT count(*) FROM lake.t WHERE s.x > 5000), (SELECT count(*) FROM lake.t WHERE v::DOUBLE > 5000)
----
1	1	1	1

query II
SELECT max(d), max(f) FROM lake.t
----
nan	nan

query II
SELECT count(*), count(contains_nan) FROM meta.ducklake_file_column_stats
----
5	0

query II
SELECT count(contains_nan), bool_or(contains(extra_stats, 'contains_nan')) FROM meta.ducklake_table_column_stats
----
0	false

query I
SELECT count(contains_nan) FROM meta.ducklake_file_variant_stats
----
0

# the NaN flags of files written after the migration are kept when it runs again
unzip data/old_ducklake/nan_row_groups.db.gz {TEST_DIR}/v10_nan_row_groups_rerun.db

statement ok
ATTACH 'ducklake:{TEST_DIR}/v10_nan_row_groups_rerun.db' AS rerun (DATA_PATH '{TEST_DIR}/v10_nan_row_groups_rerun/', OVERRIDE_DATA_PATH TRUE, METADATA_CATALOG 'rerun_meta', DUCKLAKE_VERSION '1.1-dev1', AUTOMATIC_MIGRATION TRUE, DATA_INLINING_ROW_LIMIT 0)

statement ok
INSERT INTO rerun.t VALUES (3000, 1, 1, {'x': 1}, 1::DOUBLE::VARIANT)

statement ok
DETACH rerun

statement ok
ATTACH 'ducklake:{TEST_DIR}/v10_nan_row_groups_rerun.db' AS rerun (DATA_PATH '{TEST_DIR}/v10_nan_row_groups_rerun/', OVERRIDE_DATA_PATH TRUE, METADATA_CATALOG 'rerun_meta', DUCKLAKE_VERSION '1.1-dev1', AUTOMATIC_MIGRATION TRUE)

query II
SELECT data_file_id, contains_nan FROM rerun_meta.ducklake_file_column_stats WHERE contains_nan IS NOT NULL ORDER BY ALL
----
1	false
1	false
1	false
