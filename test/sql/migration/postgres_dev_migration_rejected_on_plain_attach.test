# name: test/sql/migration/postgres_dev_migration_rejected_on_plain_attach.test
# description: A plain attach recovers when Postgres rejects the development schema additions
# group: [migration]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CONNECTION postgres:dbname=ducklakedb

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'dbname=ducklakedb' AS pg (TYPE postgres)

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA IF EXISTS dev_migration_rejected CASCADE')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl
(DATA_PATH '{DATA_PATH}/dev_migration_rejected', METADATA_SCHEMA 'dev_migration_rejected', DUCKLAKE_VERSION '1.1-dev1')

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

statement ok
DETACH dl

# an older development catalog lacks one of the additions, and its version cannot be updated
statement ok
CALL postgres_execute('pg', 'ALTER TABLE dev_migration_rejected.ducklake_delete_file DROP COLUMN row_group_count')

statement ok
CALL postgres_execute('pg', 'ALTER TABLE dev_migration_rejected.ducklake_metadata ADD CONSTRAINT reject_version_update CHECK (key <> ''version'') NOT VALID')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (METADATA_SCHEMA 'dev_migration_rejected')

query I
SELECT * FROM dl.t
----
42

statement ok
DETACH dl

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA dev_migration_rejected CASCADE')

statement ok
DETACH pg
