# name: test/sql/issues/issue_1186_hugeint_parquet_precision.test
# description: HUGEINT and UHUGEINT values written to Parquet round-trip exactly
# group: [issues]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/issue_1186', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t (h HUGEINT, u UHUGEINT)

statement ok
ALTER TABLE dl.t SET SORTED BY (h)

statement ok
INSERT INTO dl.t VALUES (170141183460469231731687303715884105727, 340282366920938463463374607431768211455), (9, 10), (10, 9)

query II
SELECT * FROM dl.t ORDER BY h
----
9	10
10	9
170141183460469231731687303715884105727	340282366920938463463374607431768211455

# files are not pruned by bounds in text order
query I
SELECT h FROM dl.t WHERE h = 9
----
9

query I
SELECT u FROM dl.t WHERE u > 9 ORDER BY u
----
10
340282366920938463463374607431768211455

statement ok
UPDATE dl.t SET h = h - 1 WHERE u = 340282366920938463463374607431768211455

statement ok
CALL ducklake_rewrite_data_files('dl', 't', delete_threshold => 0)

statement ok
INSERT INTO dl.t VALUES (123456789012345678901234567890, 1)

statement ok
CALL ducklake_merge_adjacent_files('dl')

query II
SELECT h, u FROM dl.t WHERE h > 10 ORDER BY h
----
123456789012345678901234567890	1
170141183460469231731687303715884105726	340282366920938463463374607431768211455

statement ok
CREATE TABLE dl.agg AS SELECT sum(x) AS total FROM (VALUES (9007199254740993::BIGINT), (0::BIGINT)) t(x)

query I
SELECT total FROM dl.agg
----
9007199254740993

# flushed rows are sorted by value
statement ok
CREATE TABLE dl.f (p INTEGER, h HUGEINT)

statement ok
ALTER TABLE dl.f SET PARTITIONED BY (p)

statement ok
ALTER TABLE dl.f SET SORTED BY (h)

statement ok
CALL dl.set_option('data_inlining_row_limit', 10, table_name => 'f')

statement ok
INSERT INTO dl.f VALUES (1, 100), (1, 9), (1, 170141183460469231731687303715884105727), (2, 5)

statement ok
CALL ducklake_flush_inlined_data('dl')

statement ok
SET threads=1

query I
SELECT h FROM dl.f WHERE p = 1
----
9
100
170141183460469231731687303715884105727

# nested values are compared in their own type
statement ok
CREATE TABLE dl.n (l HUGEINT[], s STRUCT(x UHUGEINT))

statement ok
INSERT INTO dl.n VALUES ([10, 9], {'x': 10}), ([9], {'x': 9}), ([100], {'x': 100})

query II
SELECT l, s FROM dl.n WHERE l > [9::HUGEINT] AND s > {'x': 9::UHUGEINT} ORDER BY s.x
----
[10, 9]	{'x': 10}
[100]	{'x': 100}
