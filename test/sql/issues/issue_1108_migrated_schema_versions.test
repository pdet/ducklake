# name: test/sql/issues/issue_1108_migrated_schema_versions.test
# description: Repair the schema version begin snapshots written by the v0.3 migration of DuckDB 1.5.0 and 1.5.1
# group: [issues]

require ducklake

require parquet

# v0.3 catalogs migrated by DuckDB 1.5.1, one of them expired with dropped tables
unzip data/old_ducklake/schema_versions_v151.db.gz {TEST_DIR}/issue_1108.db

unzip data/old_ducklake/schema_versions_v151_expired.db.gz {TEST_DIR}/issue_1108_expired.db

# a catalog where a struct field was added after a change whose objects were expired
unzip data/old_ducklake/schema_versions_v151_nested.db.gz {TEST_DIR}/issue_1108_nested.db

statement ok
ATTACH 'ducklake:{TEST_DIR}/issue_1108.db' AS dl (DATA_PATH '{TEST_DIR}/issue_1108', OVERRIDE_DATA_PATH TRUE, AUTOMATIC_MIGRATION TRUE)

query I
SELECT list((begin_snapshot, schema_version) ORDER BY schema_version) FROM __ducklake_metadata_dl.ducklake_schema_versions WHERE table_id = 1
----
[(1, 1), (2, 2), (3, 3)]

statement ok
CREATE TABLE dl.t2 (id INTEGER)

query II
SELECT * FROM dl.t0 ORDER BY ALL
----
1	10
2	20

statement ok
ATTACH 'ducklake:{TEST_DIR}/issue_1108_expired.db' AS expired (DATA_PATH '{TEST_DIR}/issue_1108_expired', OVERRIDE_DATA_PATH TRUE, AUTOMATIC_MIGRATION TRUE)

query II
SELECT * FROM expired.t0 ORDER BY ALL
----
1	10
2	20

statement ok
ATTACH 'ducklake:{TEST_DIR}/issue_1108_nested.db' AS nested (DATA_PATH '{TEST_DIR}/issue_1108_nested', OVERRIDE_DATA_PATH TRUE, AUTOMATIC_MIGRATION TRUE)

query II
SELECT * FROM nested.t ORDER BY id
----
1	{'a': 1, 'b': NULL}
2	{'a': 2, 'b': 3}
