# name: test/sql/issues/issue_1376_ordered_insert.test
# description: A write keeps the order of its input, and a sorted table writes files with disjoint key ranges (#1376, #1356)
# group: [issues]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/issue_1376', DATA_INLINING_ROW_LIMIT 0, METADATA_CATALOG 'meta')

statement ok
SET threads = 8

statement ok
SET preserve_insertion_order = true

statement ok
COPY (SELECT i AS id FROM range(300000) t(i)) TO '{DATA_PATH}/issue_1376_src.parquet' (ROW_GROUP_SIZE 10000)

# CREATE TABLE AS keeps the order of its input
statement ok
CREATE TABLE ducklake.ctas AS SELECT * FROM read_parquet('{DATA_PATH}/issue_1376_src.parquet')

query II
SELECT count(*) FILTER (WHERE id <> file_row_number), count(*)
FROM read_parquet('{DATA_PATH}/issue_1376/main/ctas/*.parquet', file_row_number := true)
----
0	300000

# so does INSERT INTO ... SELECT
statement ok
CREATE TABLE ducklake.ins (id BIGINT)

statement ok
INSERT INTO ducklake.ins SELECT * FROM read_parquet('{DATA_PATH}/issue_1376_src.parquet')

query II
SELECT count(*) FILTER (WHERE id <> file_row_number), count(*)
FROM read_parquet('{DATA_PATH}/issue_1376/main/ins/*.parquet', file_row_number := true)
----
0	300000

# a sorted table writes files whose key ranges do not overlap, whatever the setting says
statement ok
SET preserve_insertion_order = false

statement ok
CREATE TABLE ducklake.sorted (k BIGINT)

statement ok
ALTER TABLE ducklake.sorted SET SORTED BY (k ASC)

statement ok
CALL ducklake.set_option('target_file_size', '1MB', table_name => 'sorted')

statement ok
INSERT INTO ducklake.sorted SELECT (i * 7919) % 1500000 FROM range(1500000) t(i)

statement ok
CREATE TEMP TABLE ranges AS
SELECT s.data_file_id AS f, s.min_value::BIGINT AS mn, s.max_value::BIGINT AS mx
FROM meta.ducklake_file_column_stats s JOIN meta.ducklake_data_file d USING (data_file_id)
WHERE d.table_id = 3

query I
SELECT count(*) > 1 FROM ranges
----
true

query I
SELECT count(*) FROM ranges a JOIN ranges b ON a.f < b.f AND a.mn <= b.mx AND b.mn <= a.mx
----
0

query I
SELECT count(*) FROM ducklake.sorted
----
1500000

# a write that does not care about the order still goes through
statement ok
CREATE TABLE ducklake.unordered AS SELECT * FROM read_parquet('{DATA_PATH}/issue_1376_src.parquet')

query I
SELECT count(*) FROM ducklake.unordered
----
300000
