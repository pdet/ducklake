# name: test/sql/issues/issue_1295_add_files_no_null_count.test
# description: ducklake_add_data_files reads a NOT NULL column whose footer has no null counts (#1295)
# group: [issues]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/issue_1295_no_null_count')

statement ok
CREATE TABLE ducklake.t (http_status_code INTEGER NOT NULL, backlink_count INTEGER NOT NULL)

statement error
CALL ducklake_add_data_files('ducklake', 't', 'data/parquet/no_null_count.parquet')
----
NOT NULL constraint failed: t.backlink_count

query I
SELECT count(*) FROM ducklake.t
----
0

statement ok
CREATE TABLE ducklake.n (http_status_code INTEGER NOT NULL, backlink_count INTEGER)

statement ok
CALL ducklake_add_data_files('ducklake', 'n', 'data/parquet/no_null_count.parquet')

query II
SELECT count(http_status_code), count(backlink_count) FROM ducklake.n
----
200	0
