# name: test/sql/partitioning/partitioning_epoch_transforms.test
# description: Test epoch-based partition transforms (Iceberg-compatible)
# group: [partitioning]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__

statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/iceberg_transforms/', METADATA_CATALOG 'ducklake_metadata')

statement ok
USE ducklake;

# --- Scalar function tests (usable outside partition context) ---

# epoch_year: years since 1970
query I
SELECT epoch_year(DATE '2023-06-15')
----
53

query I
SELECT epoch_year(DATE '1970-01-01')
----
0

query I
SELECT epoch_year(TIMESTAMP '2024-03-05 10:30:00')
----
54

# epoch_month: months since 1970-01 (0-indexed)
query I
SELECT epoch_month(DATE '2023-06-15')
----
641

query I
SELECT epoch_month(DATE '1970-01-01')
----
0

query I
SELECT epoch_month(DATE '1970-02-01')
----
1

query I
SELECT epoch_month(DATE '2024-03-05')
----
650

# epoch_day: days since 1970-01-01
query I
SELECT epoch_day(DATE '1970-01-01')
----
0

query I
SELECT epoch_day(DATE '1970-01-02')
----
1

query I
SELECT epoch_day(DATE '2023-06-15')
----
19523

# epoch_hour: hours since 1970-01-01 00:00:00
query I
SELECT epoch_hour(TIMESTAMP '1970-01-01 00:00:00')
----
0

query I
SELECT epoch_hour(TIMESTAMP '1970-01-01 01:00:00')
----
1

query I
SELECT epoch_hour(TIMESTAMP '1970-01-01 01:59:59')
----
1

# NULL handling
query I
SELECT epoch_year(NULL::DATE)
----
NULL

query I
SELECT epoch_month(NULL::DATE)
----
NULL

query I
SELECT epoch_day(NULL::DATE)
----
NULL

query I
SELECT epoch_hour(NULL::TIMESTAMP)
----
NULL

# --- Partition transform tests ---

statement ok
CREATE TABLE t(id INTEGER, event_name VARCHAR, event_date DATE, amount DOUBLE)

statement ok
ALTER TABLE t SET PARTITIONED BY (epoch_year(event_date), epoch_month(event_date))

statement ok
INSERT INTO t VALUES
    (1, 'Jan Event', '2023-01-15', 100.0),
    (3, 'Jun Event', '2023-06-10', 200.0),
    (5, 'Next Year', '2024-03-05', 300.0)

statement ok
CALL ducklake_flush_inlined_data('ducklake')

# Verify data is queryable
query IIRI
SELECT * FROM t ORDER BY id
----
1	Jan Event	2023-01-15	100.0
3	Jun Event	2023-06-10	200.0
5	Next Year	2024-03-05	300.0

# Verify hive directory paths use epoch-based values
query II rowsort
SELECT DISTINCT
    regexp_extract(path, '.*epoch_year=([0-9]+)[/\\].*', 1)::INT AS yr,
    regexp_extract(path, '.*epoch_month=([0-9]+)[/\\].*', 1)::INT AS mo
FROM glob('${DATA_PATH}/iceberg_transforms/**/*.parquet') t(path)
----
53	636
53	641
54	650

# --- Day and hour transforms ---

statement ok
CREATE TABLE t_day(id INTEGER, ts TIMESTAMP)

statement ok
ALTER TABLE t_day SET PARTITIONED BY (epoch_day(ts))

statement ok
INSERT INTO t_day VALUES (1, TIMESTAMP '2023-06-15 10:00:00'), (2, TIMESTAMP '2024-01-10 14:00:00')

query II
SELECT * FROM t_day ORDER BY id
----
1	2023-06-15 10:00:00
2	2024-01-10 14:00:00

statement ok
CREATE TABLE t_hour(id INTEGER, ts TIMESTAMP)

statement ok
ALTER TABLE t_hour SET PARTITIONED BY (epoch_hour(ts))

statement ok
INSERT INTO t_hour VALUES (1, TIMESTAMP '1970-01-01 02:30:00'), (2, TIMESTAMP '1970-01-01 05:45:00')

query II
SELECT * FROM t_hour ORDER BY id
----
1	1970-01-01 02:30:00
2	1970-01-01 05:45:00
