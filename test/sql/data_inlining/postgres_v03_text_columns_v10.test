# name: test/sql/data_inlining/postgres_v03_text_columns_v10.test
# description: a 1.0 Postgres catalog reads and flushes the text columns of inlined tables created by DuckLake 0.3
# group: [data_inlining]

require ducklake

require parquet

require json

require postgres_scanner

require-env DUCKLAKE_CI

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/postgres_v03_text_columns_v10', DATA_INLINING_ROW_LIMIT 10, DUCKLAKE_VERSION '1.0')

statement ok
CREATE TABLE dl.t (id INTEGER, s VARCHAR, j JSON)

statement ok
INSERT INTO dl.t VALUES (1, 'back\slash \x62 é漢', '{"a": "é"}'), (2, '', NULL), (3, NULL, '[1]')

# DuckLake 0.3 created these columns with their native Postgres types, and the 1.0 migration kept them
statement ok
CALL postgres_execute('__ducklake_metadata_dl', 'ALTER TABLE ducklake_inlined_data_1_1 ALTER COLUMN s TYPE VARCHAR USING convert_from(s, ''UTF8''), ALTER COLUMN j TYPE JSON USING convert_from(j, ''UTF8'')::JSON')

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/postgres_v03_text_columns_v10', DATA_INLINING_ROW_LIMIT 10)

query III
SELECT id, s, j FROM dl.t ORDER BY id
----
1	back\slash \x62 é漢	{"a": "é"}
2	(empty)	NULL
3	NULL	[1]

query I
SELECT id FROM dl.t WHERE s = 'back\slash \x62 é漢'
----
1

statement ok
CALL ducklake_flush_inlined_data('dl')

query III
SELECT id, s, j FROM dl.t ORDER BY id
----
1	back\slash \x62 é漢	{"a": "é"}
2	(empty)	NULL
3	NULL	[1]

query I
SELECT value FROM __ducklake_metadata_dl.ducklake_metadata WHERE key = 'version'
----
1.0
