# name: test/sql/data_inlining/postgres_local_inlined_long_names.test
# description: rows inlined in a transaction refuse column names longer than postgres identifiers
# group: [data_inlining]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CI

require-env DUCKLAKE_CONNECTION

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS pg

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA IF EXISTS postgres_local_inlined_long_names CASCADE')

statement ok
DETACH pg

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/pg_local_inlined_long_names',
    METADATA_SCHEMA 'postgres_local_inlined_long_names', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER, j INTEGER)

statement ok
BEGIN

statement ok
INSERT INTO dl.t VALUES (1, 10)

statement error
ALTER TABLE dl.t ADD COLUMN b_very_long_column_name_that_is_longer_than_sixty_three_bytes_xyz INTEGER DEFAULT 7
----
the metadata catalog cannot inline the column

statement ok
ROLLBACK

statement ok
BEGIN

statement ok
INSERT INTO dl.t VALUES (1, 10)

statement error
ALTER TABLE dl.t RENAME COLUMN j TO a_very_long_column_name_that_is_longer_than_sixty_three_bytes_xyz
----
the metadata catalog cannot inline the column

statement ok
ROLLBACK

# rows committed before the change keep their inlined data table
statement ok
INSERT INTO dl.t VALUES (1, 10)

statement ok
ALTER TABLE dl.t RENAME COLUMN j TO a_very_long_column_name_that_is_longer_than_sixty_three_bytes_xyz

statement ok
ALTER TABLE dl.t ADD COLUMN b_very_long_column_name_that_is_longer_than_sixty_three_bytes_xyz INTEGER DEFAULT 7

statement ok
INSERT INTO dl.t VALUES (2, 20, 8)

query III
SELECT * FROM dl.t ORDER BY i
----
1	10	7
2	20	8
