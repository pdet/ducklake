# name: test/sql/data_inlining/postgres_inlining.test
# description: Test inlined data on postgres
# group: [data_inlining]

require ducklake

require parquet

require postgres_scanner

require json

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

# issue 9734

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/pg_lake');

statement ok
CALL ducklake.set_option('data_inlining_row_limit', 5000);

statement ok
CREATE TABLE t(id BIGINT, s STRUCT(a INTEGER, ts TIMESTAMP));

statement ok
INSERT INTO t VALUES (1, {'a': 1, 'ts': TIMESTAMP '2026-01-01 12:00:00'});

query II
SELECT * FROM t;
----
1	{'a': 1, 'ts': '2026-01-01 12:00:00'}

# issue 1155

statement ok
ATTACH 'ducklake:postgres=localhost dbname=ducklakedb user=postgres password=pass' AS pg_lake (
    DATA_PATH '{DATA_PATH}/pg_lake',
    OVERRIDE_DATA_PATH TRUE,
    DATA_INLINING_ROW_LIMIT 10
);

statement ok
DROP TABLE IF EXISTS pg_lake.test_struct;
CREATE TABLE pg_lake.test_struct (
    id VARCHAR,
    attrs STRUCT(name VARCHAR, ts TIMESTAMPTZ)
);

statement ok
INSERT INTO pg_lake.test_struct VALUES (
    'row1',
    {'name': 'foo', 'ts': TIMESTAMPTZ '2026-05-13 04:56:37+00'}
);

statement ok
CHECKPOINT pg_lake;

query II
SELECT * FROM pg_lake.test_struct;
----
row1	{'name': foo, 'ts': '2026-05-13 04:56:37+00'}

# issue 1175

statement ok
DROP TABLE IF EXISTS pg_lake.events;
CREATE TABLE pg_lake.events (
    id INTEGER,
    description JSON
);

statement ok
INSERT INTO pg_lake.events VALUES (
    1,
    '{"title": "some title", "description": "desc"}'
);

query II
SELECT * FROM pg_lake.events;
----
1	{"title": "some title", "description": "desc"}