# name: test/sql/data_inlining/data_inlining_variant_nested.test
# description: VARIANTs nested inside STRUCT/LIST/MAP columns are inlined on every metadata backend
# group: [data_inlining]

require ducklake

require parquet

require json

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_inlining_variant_nested', METADATA_CATALOG 'ducklake_meta', DATA_INLINING_ROW_LIMIT 10000)

statement ok
CREATE TABLE ducklake.nested(id INTEGER, s STRUCT(v VARIANT, n INTEGER), l VARIANT[], m MAP(VARCHAR, VARIANT), deep STRUCT(lvl2 STRUCT(vs VARIANT[])[]));

statement ok
INSERT INTO ducklake.nested VALUES
  (1, {'v': 42, 'n': 7}, [1::VARIANT, 'x'::VARIANT, NULL], MAP {'a': 1::VARIANT, 'b': 'two'::VARIANT}, {'lvl2': [{'vs': [DATE '2000-01-01'::VARIANT, 2.5::VARIANT]}, {'vs': []}]}),
  (2, {'v': NULL, 'n': NULL}, [], MAP {}, {'lvl2': []}),
  (3, NULL, NULL, NULL, NULL),
  (4, {'v': '{"k": [true, null]}'::JSON::VARIANT, 'n': 1}, [{'q': 1}::VARIANT], MAP {'x': NULL::VARIANT}, {'lvl2': NULL});

query I
SELECT COUNT(*) FROM ducklake_list_files('ducklake', 'nested')
----
0

query IIIII
SELECT id, s, l, m, deep FROM ducklake.nested ORDER BY id
----
1	{'v': 42, 'n': 7}	[1, x, NULL]	{a=1, b=two}	{'lvl2': [{'vs': [2000-01-01, 2.5]}, {'vs': []}]}
2	{'v': NULL, 'n': NULL}	[]	{}	{'lvl2': []}
3	NULL	NULL	NULL	NULL
4	{'v': {'k': [true, NULL]}, 'n': 1}	[{'q': 1}]	{x=NULL}	{'lvl2': NULL}

query IIII
SELECT id, variant_typeof(s.v), variant_typeof(l[1]), variant_typeof(deep.lvl2[1].vs[1]) FROM ducklake.nested ORDER BY id
----
1	INT32	INT32	DATE
2	VARIANT_NULL	VARIANT_NULL	VARIANT_NULL
3	VARIANT_NULL	VARIANT_NULL	VARIANT_NULL
4	OBJECT(k)	OBJECT(q)	VARIANT_NULL

query I
SELECT s.v = 42 FROM ducklake.nested WHERE id = 1
----
true

# a list child larger than one vector, and many rows
statement ok
CREATE TABLE ducklake.big(id INTEGER, l VARIANT[]);

statement ok
INSERT INTO ducklake.big SELECT 1, list_transform(range(5000), lambda x: x::VARIANT);

statement ok
INSERT INTO ducklake.big SELECT i, [i::VARIANT, (i::VARCHAR)::VARIANT] FROM range(2, 3000) t(i);

query I
SELECT COUNT(*) FROM ducklake_list_files('ducklake', 'big')
----
0

query III
SELECT len(l), l[1], l[5000] FROM ducklake.big WHERE id = 1
----
5000	0	4999

query III
SELECT COUNT(*), SUM(l[1]::INTEGER), COUNT(*) FILTER (WHERE variant_typeof(l[2]) = 'VARCHAR') FROM ducklake.big WHERE id > 1
----
2998	4498499	2998

# update and delete rows holding nested variants
statement ok
UPDATE ducklake.nested SET s = {'v': 'updated', 'n': 8}, l = ['u'::VARIANT] WHERE id = 1

statement ok
DELETE FROM ducklake.nested WHERE id = 3

query IIII
SELECT id, s, l, variant_typeof(s.v) FROM ducklake.nested ORDER BY id
----
1	{'v': updated, 'n': 8}	[u]	VARCHAR
2	{'v': NULL, 'n': NULL}	[]	VARIANT_NULL
4	{'v': {'k': [true, NULL]}, 'n': 1}	[{'q': 1}]	OBJECT(k)

query I
SELECT COUNT(*) FROM ducklake_list_files('ducklake', 'nested')
----
0

query IIII nosort nested_state
SELECT id, s, l, m FROM ducklake.nested ORDER BY id
----

# flushing requires the parquet writer to support nested VARIANT columns
statement maybe
CALL ducklake_flush_inlined_data('ducklake', table_name => 'nested')
----
requires a transform

query IIII nosort nested_state
SELECT id, s, l, m FROM ducklake.nested ORDER BY id
----
