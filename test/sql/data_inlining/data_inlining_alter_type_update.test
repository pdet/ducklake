# name: test/sql/data_inlining/data_inlining_alter_type_update.test
# description: test ALTER COLUMN TYPE followed by UPDATE within same transaction (regression for heap-use-after-free)
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__

statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/ducklake_alter_type_update', METADATA_CATALOG 'ducklake_meta', DATA_INLINING_ROW_LIMIT 1000)

statement ok
CREATE TABLE ducklake.test(id INTEGER, val TEXT)

statement ok
INSERT INTO ducklake.test VALUES (1, 'a'), (2, 'b'), (3, 'c')

# verify initial data
query IT
SELECT * FROM ducklake.test ORDER BY id
----
1	a
2	b
3	c

# ALTER COLUMN TYPE + UPDATE in same transaction
# this previously caused a heap-use-after-free in StatisticsPropagator::CanPropagateCast
# because the UPDATE's filter pushdown referenced stale LogicalType objects from the pre-ALTER schema
statement ok
BEGIN

statement ok
ALTER TABLE ducklake.test ALTER COLUMN id TYPE BIGINT

statement ok
UPDATE ducklake.test SET val = 'X' WHERE id = 1

query IT
SELECT * FROM ducklake.test ORDER BY id
----
1	X
2	b
3	c

statement ok
COMMIT

# verify data persists after commit
query IT
SELECT * FROM ducklake.test ORDER BY id
----
1	X
2	b
3	c

query I
SELECT typeof(id) FROM ducklake.test LIMIT 1
----
BIGINT

# test ALTER TYPE + DELETE with filter in same transaction
statement ok
CREATE TABLE ducklake.test2(id INTEGER, val TEXT)

statement ok
INSERT INTO ducklake.test2 VALUES (10, 'x'), (20, 'y'), (30, 'z')

statement ok
BEGIN

statement ok
ALTER TABLE ducklake.test2 ALTER COLUMN id TYPE BIGINT

statement ok
DELETE FROM ducklake.test2 WHERE id = 20

query IT
SELECT * FROM ducklake.test2 ORDER BY id
----
10	x
30	z

statement ok
COMMIT

query IT
SELECT * FROM ducklake.test2 ORDER BY id
----
10	x
30	z

# test ALTER TYPE + SELECT with filter in same transaction
statement ok
CREATE TABLE ducklake.test3(id INTEGER, val TEXT)

statement ok
INSERT INTO ducklake.test3 VALUES (100, 'p'), (200, 'q'), (300, 'r')

statement ok
BEGIN

statement ok
ALTER TABLE ducklake.test3 ALTER COLUMN id TYPE BIGINT

query IT
SELECT * FROM ducklake.test3 WHERE id = 200
----
200	q

statement ok
COMMIT
