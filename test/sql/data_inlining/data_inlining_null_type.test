# name: test/sql/data_inlining/data_inlining_null_type.test
# description: inline NULL-typed columns in the metadata catalog
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/data_inlining_null_type', METADATA_CATALOG 'ducklake_meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
USE ducklake

statement ok
CREATE TABLE t(id INTEGER, n "NULL", l "NULL"[], s STRUCT(x "NULL"), m MAP(VARCHAR, "NULL"))

statement ok
INSERT INTO t VALUES (1, NULL, [NULL], {'x': NULL}, MAP {'k': NULL}), (2, NULL, NULL, NULL, NULL), (3, NULL, [], {'x': NULL}, MAP {})

# the rows live in the metadata catalog, not in files
query I
SELECT COUNT(*) FROM ducklake_list_files('ducklake', 't')
----
0

query I
SELECT COUNT(*) FROM ducklake_meta.ducklake_inlined_data_tables WHERE table_id = (SELECT table_id FROM ducklake_meta.ducklake_table WHERE table_name = 't' AND end_snapshot IS NULL)
----
1

# reading casts the catalog's storage type back to NULL
query IIIII
SELECT id, n, l, s, m FROM t ORDER BY id
----
1	NULL	[NULL]	{'x': NULL}	{k=NULL}
2	NULL	NULL	NULL	NULL
3	NULL	[]	{'x': NULL}	{}

query IIII
SELECT typeof(n), typeof(l), typeof(s), typeof(m) FROM t LIMIT 1
----
"NULL"	"NULL"[]	STRUCT(x "NULL")	MAP(VARCHAR, "NULL")

query III
SELECT COUNT(*), COUNT(n), COUNT(*) FILTER (WHERE n IS NULL) FROM t
----
3	0	3

query I
SELECT id FROM t WHERE n IS NULL AND id > 1 ORDER BY id
----
2
3

query I
SELECT COUNT(*) FROM t WHERE n = 1
----
0

# inlined rows can be updated and deleted
statement ok
UPDATE t SET id = id + 10 WHERE id = 1

statement ok
DELETE FROM t WHERE id = 2

query II
SELECT id, n FROM t ORDER BY id
----
3	NULL
11	NULL

# time travel over inlined NULL rows
statement ok
SET VARIABLE snap = (SELECT MAX(snapshot_id) FROM ducklake_snapshots('ducklake'))

query II
SELECT id, n FROM t AT (VERSION => getvariable('snap') - 2) ORDER BY id
----
1	NULL
2	NULL
3	NULL

query III
SELECT id, n, change_type FROM ducklake_table_changes('ducklake', 'main', 't', getvariable('snap'), getvariable('snap')) ORDER BY id
----
2	NULL	delete

# promoting an inlined NULL column keeps the rows inlined
statement ok
ALTER TABLE t ALTER n TYPE INTEGER

statement ok
ALTER TABLE t ALTER l TYPE INTEGER[]

query II
SELECT id, n FROM t ORDER BY id
----
3	NULL
11	NULL

statement ok
INSERT INTO t VALUES (4, 40, [4], {'x': NULL}, MAP {'k': NULL})

query I
SELECT COUNT(*) FROM ducklake_list_files('ducklake', 't')
----
0

query IIIII
SELECT id, n, l, s, m FROM t ORDER BY id
----
3	NULL	[]	{'x': NULL}	{}
4	40	[4]	{'x': NULL}	{k=NULL}
11	NULL	[NULL]	{'x': NULL}	{k=NULL}

query I
SELECT id FROM t WHERE n = 40
----
4

query III
SELECT COUNT(*), COUNT(n), COUNT(*) FILTER (WHERE n IS NULL) FROM t
----
3	1	2

# flushing moves the rows into a parquet file
statement ok
CALL ducklake_flush_inlined_data('ducklake')

query I
SELECT COUNT(*) > 0 FROM ducklake_list_files('ducklake', 't')
----
true

query IIIII
SELECT id, n, l, s, m FROM t ORDER BY id
----
3	NULL	[]	{'x': NULL}	{}
4	40	[4]	{'x': NULL}	{k=NULL}
11	NULL	[NULL]	{'x': NULL}	{k=NULL}

query III
SELECT COUNT(*), COUNT(n), COUNT(*) FILTER (WHERE n IS NULL) FROM t
----
3	1	2

# new rows are inlined again after the flush
statement ok
INSERT INTO t VALUES (5, NULL, NULL, NULL, NULL)

query IIIII
SELECT id, n, l, s, m FROM t ORDER BY id
----
3	NULL	[]	{'x': NULL}	{}
4	40	[4]	{'x': NULL}	{k=NULL}
5	NULL	NULL	NULL	NULL
11	NULL	[NULL]	{'x': NULL}	{k=NULL}
