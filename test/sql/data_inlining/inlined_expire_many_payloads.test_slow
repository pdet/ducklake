# name: test/sql/data_inlining/inlined_expire_many_payloads.test_slow
# description: the expiry sweeps the inlined row ends of a table with a thousand payload versions in one statement
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER, j INTEGER)

# every payload version keeps a row, so it stays registered
loop v 0 1001

statement ok
INSERT INTO dl.t VALUES ({v}, {v})

statement ok
ALTER TABLE dl.t ALTER j SET DEFAULT {v}

endloop

query I
SELECT count(*) FROM meta.ducklake_inlined_data_tables WHERE table_id = 1
----
1001

statement ok
DELETE FROM dl.t WHERE i = 0

query I
SELECT count(*) FROM meta.ducklake_inlined_data_visibility
----
1

# the sweep of the ends probes every payload version of the table
statement ok
CALL ducklake_expire_snapshots('dl', older_than => now())

query I
SELECT count(*) FROM meta.ducklake_inlined_data_visibility
----
0

query III
SELECT count(*), min(i), max(i) FROM dl.t
----
1000	1	1000
