# name: test/sql/data_inlining/postgres_v03_timestamptz_utc_text.test
# description: the v1.1 migration writes the TIMESTAMPTZ columns that DuckLake 0.3 left in Postgres inlined tables as UTC text
# group: [data_inlining]

require ducklake

require parquet

require icu

require postgres_scanner

require-env DUCKLAKE_CI

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/postgres_v03_timestamptz_utc_text', DATA_INLINING_ROW_LIMIT 10, DUCKLAKE_VERSION '1.0')

statement ok
CREATE TABLE dl.t (id INTEGER, v TIMESTAMPTZ)

statement ok
INSERT INTO dl.t VALUES (1, TIMESTAMPTZ '1677-09-22 00:00:00+00'), (2, TIMESTAMPTZ '2020-06-01 00:00:00+00')

# DuckLake 0.3 created this column with its native Postgres type
statement ok
CALL postgres_execute('__ducklake_metadata_dl', 'ALTER TABLE ducklake_inlined_data_1_1 ALTER COLUMN v TYPE TIMESTAMPTZ USING v::TIMESTAMPTZ')

statement ok
DETACH dl

statement ok
SET TimeZone = 'Europe/Amsterdam'

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/postgres_v03_timestamptz_utc_text', DATA_INLINING_ROW_LIMIT 10, DUCKLAKE_VERSION '1.1-dev1', AUTOMATIC_MIGRATION TRUE)

statement ok
SET TimeZone = 'UTC'

query II
SELECT id, v FROM dl.t ORDER BY id
----
1	1677-09-22 00:00:00+00
2	2020-06-01 00:00:00+00

query II
SELECT * FROM postgres_query('__ducklake_metadata_dl', 'SELECT id, v FROM ducklake_inlined_data_1_1 ORDER BY id')
----
1	1677-09-22 00:00:00+00
2	2020-06-01 00:00:00+00
