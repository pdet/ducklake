# name: test/sql/add_files/add_files_hive_nested_field_name.test
# description: A struct field named like a hive partition key keeps the value stored in the file
# group: [add_files]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/add_files_hive_nested_field_name')

statement ok
USE ducklake

statement ok
COPY (SELECT {'a': 7, 'b': 8} AS s, 1 AS a) TO '{DATA_PATH}/add_files_hive_nested_field_name_files' (FORMAT parquet, PARTITION_BY (a))

# hive partitions only apply to top-level columns, like in read_parquet
query II
SELECT s, a FROM read_parquet('{DATA_PATH}/add_files_hive_nested_field_name_files/a=1/*.parquet', hive_partitioning => true)
----
{'a': 7, 'b': 8}	1

statement ok
CREATE TABLE t(s STRUCT(a INTEGER, b INTEGER), a INTEGER)

statement ok
CALL ducklake_add_data_files('ducklake', 't', '{DATA_PATH}/add_files_hive_nested_field_name_files/a=1/*.parquet', hive_partitioning => true)

query I
SELECT a FROM t
----
1

# FIXME: the hive value replaces the struct field s.a, see https://github.com/pdet/ducklake_internal/issues/110
mode skip

query II
SELECT s, a FROM t
----
{'a': 7, 'b': 8}	1

mode unskip
