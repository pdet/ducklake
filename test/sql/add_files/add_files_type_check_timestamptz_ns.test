# name: test/sql/add_files/add_files_type_check_timestamptz_ns.test
# description: Adding Parquet files with TIMESTAMPTZ_NS columns to TIMESTAMPTZ_NS columns
# group: [add_files]

require ducklake

require parquet

require icu

statement ok
SET TimeZone = 'UTC'

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/add_files_type_check_timestamptz_ns', DATA_INLINING_ROW_LIMIT 0)

statement ok
COPY (SELECT TIMESTAMPTZ_NS '2020-01-01 12:34:56.123456789+00' AS t) TO '{DATA_PATH}/add_files_type_check_tstz_ns.parquet'

statement ok
CREATE TABLE dl.tstz_ns (t TIMESTAMPTZ_NS)

statement ok
CALL ducklake_add_data_files('dl', 'tstz_ns', '{DATA_PATH}/add_files_type_check_tstz_ns.parquet')

query I
SELECT t FROM dl.tstz_ns WHERE t > TIMESTAMPTZ_NS '2020-01-01 12:34:56.123456788+00'
----
2020-01-01 12:34:56.123456789+00
