# name: test/sql/default/literal_default_rendering_timestamptz_ns.test
# description: literal TIMESTAMPTZ_NS column defaults are cast when used, in the time zone of the session
# group: [default]

require ducklake

require parquet

require icu

test-env DUCKLAKE_CONNECTION {TEST_DIR}/literal_default_rendering_timestamptz_ns.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/literal_default_rendering_timestamptz_ns')

statement ok
SET TimeZone = 'America/New_York'

statement ok
CREATE TABLE dl.z (ns TIMESTAMPTZ_NS DEFAULT '2020-01-01 00:00:00.123456789', k INTEGER)

statement ok
CALL dl.set_option('data_inlining_row_limit', 10, table_name => 'z')

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/literal_default_rendering_timestamptz_ns')

statement ok
INSERT INTO dl.z (k) VALUES (1)

query I
SELECT ns = TIMESTAMPTZ_NS '2020-01-01 05:00:00.123456789+00' FROM dl.z
----
true

statement ok
SET TimeZone = 'Asia/Tokyo'

statement ok
INSERT INTO dl.z (k) VALUES (2)

query I
SELECT ns = TIMESTAMPTZ_NS '2019-12-31 15:00:00.123456789+00' FROM dl.z WHERE k = 2
----
true

# a DATE default widened to TIMESTAMPTZ_NS in a transaction is midnight in the session time zone
statement ok
SET TimeZone = 'America/New_York'

statement ok
CREATE TABLE dl.dt (d DATE DEFAULT DATE '2020-01-01', k INTEGER)

statement ok
CALL dl.set_option('data_inlining_row_limit', 10, table_name => 'dt')

statement ok
BEGIN

statement ok
ALTER TABLE dl.dt ALTER d TYPE TIMESTAMPTZ_NS

statement ok
INSERT INTO dl.dt (k) VALUES (1)

statement ok
COMMIT

statement ok
INSERT INTO dl.dt (k) VALUES (2)

query II
SELECT k, d = TIMESTAMPTZ_NS '2020-01-01 05:00:00+00' FROM dl.dt ORDER BY k
----
1	true
2	true
