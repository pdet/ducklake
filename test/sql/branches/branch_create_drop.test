# name: test/sql/branches/branch_create_drop.test
# description: creating, listing and dropping branches
# group: [branches]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/branch_create_drop_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2)

statement ok
DELETE FROM dl.t WHERE i = 1

statement ok
CALL ducklake_create_branch('dl', 'dev')

# the branch is one row that continues from the snapshot of main at its fork and inherits the files and deletes visible there
query III
SELECT branch_name, parent_id, parent_branch_snapshot FROM ducklake_branches('dl') ORDER BY branch_id
----
main	NULL	NULL
dev	0	3

query I
SELECT COUNT(*) FROM meta.ducklake_file_visibility WHERE branch_id = 1
----
0

query I
SELECT COUNT(*) FROM meta.ducklake_delete_file_visibility WHERE branch_id = 1
----
0

# later commits on main stay invisible to the branch
statement ok
INSERT INTO dl.t VALUES (3)

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dev (DATA_PATH '{DATA_PATH}/branch_create_drop_files', METADATA_CATALOG 'meta', BRANCH 'dev')

query I
SELECT i FROM dev.t
----
2

statement ok
DETACH dev

# a branch name in time travel reads what main held at the fork
query I
SELECT i FROM dl.t AT (VERSION => 'dev')
----
2

query I
SELECT COUNT(*) FROM dl.t AT (VERSION => 'main')
----
2

# names are refs, not snapshots
statement error
CALL ducklake_create_branch('dl', 'dev')
----
already exists

statement error
CALL ducklake_create_branch('dl', 'main')
----
cannot be named

statement error
CALL ducklake_create_branch('dl', '42')
----
cannot be named like a snapshot id

statement error
CALL ducklake_drop_branch('dl', 'main')
----
cannot be dropped

statement error
CALL ducklake_drop_branch('dl', 'nope')
----
does not exist

# a historic fork selects what that snapshot saw
statement ok
CALL ducklake_create_branch('dl', 'past', version => 2)

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS past (DATA_PATH '{DATA_PATH}/branch_create_drop_files', METADATA_CATALOG 'meta', BRANCH 'past')

query I
SELECT i FROM past.t ORDER BY i
----
1
2

statement ok
DETACH past

# the fork point of a live branch cannot be expired
query I
SELECT COUNT(*) FROM ducklake_expire_snapshots('dl', versions => [2], dry_run => true)
----
0

# a rolled back creation leaves nothing behind
statement ok
BEGIN

statement ok
CALL ducklake_create_branch('dl', 'gone')

query I
SELECT COUNT(*) FROM ducklake_branches('dl') WHERE branch_name = 'gone'
----
1

statement ok
ROLLBACK

query I
SELECT COUNT(*) FROM ducklake_branches('dl') WHERE branch_name = 'gone'
----
0

# dropping a branch removes its row, its snapshots, its events and the ends it wrote for catalog rows
statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT 4, NOW(), schema_version, next_catalog_id, next_file_id, 1 FROM meta.ducklake_snapshot WHERE snapshot_id = 3 AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (4, NULL, NULL, NULL, NULL, 1)

statement ok
INSERT INTO meta.ducklake_table_visibility SELECT 1, table_id, branch_id, begin_snapshot, 4 FROM meta.ducklake_table WHERE table_name = 't'

# the end written on the branch does not touch main
query I
SELECT COUNT(*) FROM dl.t
----
2

statement ok
CALL ducklake_drop_branch('dl', 'dev')

query I
SELECT COUNT(*) FROM ducklake_branches('dl') WHERE branch_name = 'dev'
----
0

query I
SELECT COUNT(*) FROM meta.ducklake_snapshot WHERE branch_id = 1
----
0

query I
SELECT COUNT(*) FROM meta.ducklake_snapshot_changes WHERE branch_id = 1
----
0

query I
SELECT COUNT(*) FROM meta.ducklake_file_visibility WHERE branch_id = 1
----
0

query I
SELECT COUNT(*) FROM meta.ducklake_table_visibility WHERE branch_id = 1
----
0

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dev (DATA_PATH '{DATA_PATH}/branch_create_drop_files', METADATA_CATALOG 'meta', BRANCH 'dev')
----
No branch with the name "dev" exists

statement ok
DETACH dl

# a branch name can be dropped and created again in one transaction
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/branch_create_drop_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CALL ducklake_create_branch('dl', 'redo')

statement ok
BEGIN

statement ok
CALL ducklake_drop_branch('dl', 'redo')

statement ok
CALL ducklake_create_branch('dl', 'redo')

statement ok
COMMIT

query I
SELECT COUNT(*) FROM ducklake_branches('dl') WHERE branch_name = 'redo'
----
1

# a pending drop hides the branch
statement ok
BEGIN

statement ok
CALL ducklake_drop_branch('dl', 'redo')

query I
SELECT COUNT(*) FROM ducklake_branches('dl') WHERE branch_name = 'redo'
----
0

statement ok
ROLLBACK

# a branch that another branch continues from cannot be dropped
statement ok
INSERT INTO meta.ducklake_branch SELECT 50, 'child', branch_id, 1 FROM meta.ducklake_branch WHERE branch_name = 'redo'

statement error
CALL ducklake_drop_branch('dl', 'redo')
----
continues from it

statement ok
DELETE FROM meta.ducklake_branch WHERE branch_id = 50

# a fork created in this transaction is protected from its own expiry
statement ok
INSERT INTO dl.t VALUES (4)

statement ok
BEGIN

statement ok
CALL ducklake_create_branch('dl', 'guarded', version => 2)

query I
SELECT COUNT(*) FROM ducklake_expire_snapshots('dl', versions => [2], dry_run => true)
----
0

statement ok
COMMIT

# dropping the branches of a fork releases it for expiry in the same transaction
statement ok
BEGIN

statement ok
CALL ducklake_drop_branch('dl', 'guarded')

statement ok
CALL ducklake_drop_branch('dl', 'past')

query I
SELECT COUNT(*) > 0 FROM ducklake_expire_snapshots('dl', versions => [2], dry_run => true)
----
true

statement ok
ROLLBACK

# a tag dropped in this transaction loses precedence over a branch of the same name
statement ok
CALL ducklake_create_tag('dl', 'shared', version => 2)

statement ok
CALL ducklake_create_branch('dl', 'shared', version => 2)

statement ok
BEGIN

statement ok
CALL ducklake_drop_tag('dl', 'shared')

query I
SELECT COUNT(*) FROM dl.t AT (VERSION => 'shared')
----
2

statement ok
ROLLBACK

# an expiry recorded while a pending branch protected the fork applies once the branch is dropped
statement ok
INSERT INTO dl.t VALUES (5)

statement ok
INSERT INTO dl.t VALUES (6)

statement ok
SET VARIABLE fork = (SELECT MAX(snapshot_id) - 1 FROM ducklake_snapshots('dl'))

statement ok
BEGIN

statement ok
CALL ducklake_create_branch('dl', 'transient', version => getvariable('fork'))

statement ok
CALL ducklake_expire_snapshots('dl', versions => [getvariable('fork')])

statement ok
CALL ducklake_drop_branch('dl', 'transient')

statement ok
COMMIT

query I
SELECT COUNT(*) FROM ducklake_snapshots('dl') WHERE snapshot_id = getvariable('fork')
----
0

# the catalog rows born on a dropped branch and the ends that name them go with it, a branch that reuses the id inherits nothing
statement ok
CALL ducklake_create_branch('dl', 'reborn')

statement ok
SET VARIABLE reborn = (SELECT branch_id FROM ducklake_branches('dl') WHERE branch_name = 'reborn')

statement ok
SET VARIABLE fork = (SELECT parent_branch_snapshot FROM ducklake_branches('dl') WHERE branch_name = 'reborn')

# reborn creates a table and a view at its first snapshot and drops the view at its second
statement ok
INSERT INTO meta.ducklake_snapshot (snapshot_id, snapshot_time, schema_version, next_catalog_id, next_file_id, branch_id) SELECT getvariable('fork') + step, NOW(), schema_version, next_catalog_id, next_file_id, getvariable('reborn') FROM meta.ducklake_snapshot, (VALUES (1), (2)) steps(step) WHERE snapshot_id = getvariable('fork') AND branch_id = 0

statement ok
INSERT INTO meta.ducklake_snapshot_changes VALUES (getvariable('fork') + 1, NULL, NULL, NULL, NULL, getvariable('reborn')), (getvariable('fork') + 2, NULL, NULL, NULL, NULL, getvariable('reborn'))

statement ok
INSERT INTO meta.ducklake_table SELECT 1000, uuid(), getvariable('fork') + 1, schema_id, 'ghost', path, path_is_relative, getvariable('reborn') FROM meta.ducklake_table WHERE table_name = 't'

statement ok
INSERT INTO meta.ducklake_column SELECT * REPLACE (1000 AS table_id, getvariable('fork') + 1 AS begin_snapshot, getvariable('reborn') AS branch_id) FROM meta.ducklake_column WHERE table_id = (SELECT table_id FROM meta.ducklake_table WHERE table_name = 't')

# reborn partitions ghost and adds a column to t at its first snapshot and resets the partitioning at its second
statement ok
INSERT INTO meta.ducklake_partition_info VALUES (1002, 1000, getvariable('fork') + 1, getvariable('reborn'))

statement ok
INSERT INTO meta.ducklake_partition_column SELECT 1002, 1000, 0, column_id, 'identity' FROM meta.ducklake_column WHERE table_id = 1000

statement ok
INSERT INTO meta.ducklake_partition_visibility VALUES (getvariable('reborn'), 1002, getvariable('reborn'), getvariable('fork') + 1, getvariable('fork') + 2)

statement ok
INSERT INTO meta.ducklake_column SELECT 1003, getvariable('fork') + 1, table_id, 1, 'ghost_col', 'int32', NULL, NULL, true, NULL, NULL, NULL, getvariable('reborn') FROM meta.ducklake_table WHERE table_name = 't'

statement ok
INSERT INTO meta.ducklake_view VALUES (1001, uuid(), getvariable('fork') + 1, 0, 'ghost_view', 'duckdb', 'SELECT 1 AS x', NULL, getvariable('reborn'))

statement ok
INSERT INTO meta.ducklake_view_visibility VALUES (getvariable('reborn'), 1001, getvariable('reborn'), getvariable('fork') + 1, getvariable('fork') + 2)

statement ok
CALL ducklake_drop_branch('dl', 'reborn')

query III
SELECT (SELECT COUNT(*) FROM meta.ducklake_table WHERE branch_id = getvariable('reborn')), (SELECT COUNT(*) FROM meta.ducklake_view WHERE branch_id = getvariable('reborn')), (SELECT COUNT(*) FROM meta.ducklake_view_visibility WHERE row_branch_id = getvariable('reborn'))
----
0	0	0

query III
SELECT (SELECT COUNT(*) FROM meta.ducklake_column WHERE branch_id = getvariable('reborn')), (SELECT COUNT(*) FROM meta.ducklake_partition_info WHERE branch_id = getvariable('reborn')), (SELECT COUNT(*) FROM meta.ducklake_partition_visibility WHERE branch_id = getvariable('reborn') OR row_branch_id = getvariable('reborn'))
----
0	0	0

# the next branch takes the id of the dropped one
statement ok
CALL ducklake_create_branch('dl', 'again')

query I
SELECT branch_id = getvariable('reborn') FROM ducklake_branches('dl') WHERE branch_name = 'again'
----
true

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS again (DATA_PATH '{DATA_PATH}/branch_create_drop_files', METADATA_CATALOG 'meta', BRANCH 'again')

# a surviving partition of the dead table would fail the catalog load of again, a surviving column would show on t
query I
SELECT column_name FROM (DESCRIBE again.t)
----
i

statement error
SELECT * FROM again.ghost
----
does not exist

statement error
SELECT * FROM again.ghost_view
----
does not exist

statement ok
DETACH again
