# name: test/sql/bwc/deletion_vector_v1_0.test
# description: Verify that WRITE_DELETION_VECTORS is silently ignored at v1.0 (no internal error)
# group: [bwc]

require ducklake

require parquet

statement ok
SET ducklake_default_version = '1.0';

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

# Attach with WRITE_DELETION_VECTORS true at v1.0 - should not error
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/bwc_deletion_vector_v1_0', WRITE_DELETION_VECTORS true)

statement ok
CREATE TABLE ducklake.test AS SELECT i id FROM range(1000) t(i);

statement ok
INSERT INTO ducklake.test SELECT i id FROM range(15000, 16000) t(i)

query I
SELECT COUNT(*) FROM ducklake.test
----
2000

# delete should succeed (falls back to parquet delete files, not puffin)
query I
DELETE FROM ducklake.test WHERE id%2=0
----
1000

# delete files should be parquet, not puffin
query I
SELECT DISTINCT format FROM __ducklake_metadata_ducklake.ducklake_delete_file WHERE end_snapshot IS NULL
----
parquet

# verify data is correct after delete
query II
SELECT COUNT(*), COUNT(*) FILTER(WHERE id%2=0) FROM ducklake.test
----
1000	0

# time travel still works
query II
SELECT COUNT(*), COUNT(*) FILTER(WHERE id%2=0) FROM ducklake.test AT (VERSION => 2)
----
2000	1000

# additional deletes also succeed
query I
DELETE FROM ducklake.test WHERE id < 100
----
50

query I
SELECT COUNT(*) FROM ducklake.test
----
950

# delete all remaining rows from one file to test full file drop
query I
DELETE FROM ducklake.test WHERE id >= 0 AND id < 1000
----
450

query I
SELECT COUNT(*) FROM ducklake.test
----
500
