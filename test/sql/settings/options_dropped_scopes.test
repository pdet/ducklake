# name: test/sql/settings/options_dropped_scopes.test
# description: ducklake.options() lists the options of a dropped schema or table without a scope entry
# group: [settings]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/options_dropped_scopes')

statement ok
CREATE SCHEMA ducklake.s

statement ok
CREATE TABLE ducklake.s.t(i INTEGER)

statement ok
CALL ducklake.set_option('parquet_compression', 'zstd', schema => 's', table_name => 't')

statement ok
CALL ducklake.set_option('parquet_compression', 'gzip', schema => 's')

query III
SELECT value, scope, scope_entry FROM ducklake.options() WHERE scope <> 'GLOBAL' ORDER BY ALL
----
gzip	SCHEMA	s
zstd	TABLE	s.t

statement ok
DROP TABLE ducklake.s.t

statement ok
DROP SCHEMA ducklake.s

query III
SELECT value, scope, scope_entry FROM ducklake.options() WHERE scope <> 'GLOBAL' ORDER BY ALL
----
gzip	SCHEMA	NULL
zstd	TABLE	NULL

# FIXME: the options of dropped schemas and tables stay after their snapshots are expired, see https://github.com/pdet/ducklake_internal/issues/117
mode skip

statement ok
CALL ducklake_expire_snapshots('ducklake', older_than => now())

query I
SELECT count(*) FROM ducklake.options() WHERE scope <> 'GLOBAL'
----
0

mode unskip
