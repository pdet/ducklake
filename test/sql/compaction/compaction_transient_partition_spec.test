# name: test/sql/compaction/compaction_transient_partition_spec.test
# description: files of a partition spec set and reset in one transaction can be merged and rewritten
# group: [compaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/compaction_transient_spec/', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.t(p INTEGER, v INTEGER)

# the files are written directly in the table directory
statement ok
CALL lake.set_option('hive_file_pattern', false, table_name => 't')

statement ok
BEGIN

statement ok
ALTER TABLE lake.t SET PARTITIONED BY (p)

statement ok
INSERT INTO lake.t VALUES (1, 10)

statement ok
INSERT INTO lake.t VALUES (1, 20)

statement ok
ALTER TABLE lake.t RESET PARTITIONED BY

statement ok
COMMIT

query III
SELECT table_name, files_processed, files_created FROM ducklake_merge_adjacent_files('lake', 't')
----
t	2	1

query II
SELECT * FROM lake.t ORDER BY v
----
1	10
1	20

statement ok
DELETE FROM lake.t WHERE v = 10

query I
SELECT count(*) FROM ducklake_rewrite_data_files('lake', 't', delete_threshold => 0)
----
1

query II
SELECT * FROM lake.t
----
1	20

# files added from outside the table directory
statement ok
COPY (SELECT 1 AS p, 30 AS v) TO '{DATA_PATH}/compaction_transient_spec_ext1' (FORMAT parquet, PARTITION_BY (p))

statement ok
COPY (SELECT 1 AS p, 40 AS v) TO '{DATA_PATH}/compaction_transient_spec_ext2' (FORMAT parquet, PARTITION_BY (p))

statement ok
CREATE TABLE lake.e(p INTEGER, v INTEGER)

statement ok
BEGIN

statement ok
ALTER TABLE lake.e SET PARTITIONED BY (p)

statement ok
CALL ducklake_add_data_files('lake', 'e', '{DATA_PATH}/compaction_transient_spec_ext1/**/*.parquet', hive_partitioning => true)

statement ok
CALL ducklake_add_data_files('lake', 'e', '{DATA_PATH}/compaction_transient_spec_ext2/**/*.parquet', hive_partitioning => true)

statement ok
ALTER TABLE lake.e RESET PARTITIONED BY

statement ok
COMMIT

query III
SELECT table_name, files_processed, files_created FROM ducklake_merge_adjacent_files('lake', 'e')
----
e	2	1

query II
SELECT * FROM lake.e ORDER BY v
----
1	30
1	40

query I
SELECT count(*) FROM lake.e WHERE p = 1
----
2
