# name: test/sql/compaction/user_columns_named_like_internal_columns.test
# description: compaction keeps the row ids and snapshot ids of tables whose columns have the names of internal columns
# group: [compaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

# a 1.0 catalog without inlining accepts these column names
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/user_columns_named_like_internal_columns', DUCKLAKE_VERSION '1.0', DATA_INLINING_ROW_LIMIT 0)

# rewriting a file writes row ids
statement ok
CREATE TABLE dl.t (id INTEGER, _ducklake_internal_row_id BIGINT)

statement ok
INSERT INTO dl.t SELECT i, 1000 + i FROM range(10) r(i)

statement ok
DELETE FROM dl.t WHERE id < 5

statement ok
CALL ducklake_rewrite_data_files('dl', 't', delete_threshold => 0.1)

statement ok
DELETE FROM dl.t WHERE id = 5

statement ok
UPDATE dl.t SET _ducklake_internal_row_id = 0 WHERE id = 6

query II
SELECT id, _ducklake_internal_row_id FROM dl.t ORDER BY id
----
6	0
7	1007
8	1008
9	1009

# merging files writes snapshot ids, and a column with the first fallback name
statement ok
CREATE TABLE dl.s (id INTEGER, _ducklake_internal_snapshot_id BIGINT, _ducklake_internal_row_id BIGINT, _ducklake_internal_row_id_1 BIGINT)

statement ok
INSERT INTO dl.s VALUES (1, 100, 10, 11)

statement ok
SET VARIABLE v = (SELECT max(snapshot_id) FROM dl.snapshots())

statement ok
INSERT INTO dl.s VALUES (2, 200, 20, 21)

statement ok
CALL ducklake_merge_adjacent_files('dl', 's')

query IIII
SELECT * FROM dl.s AT (VERSION => getvariable('v'))
----
1	100	10	11

statement ok
DELETE FROM dl.s WHERE id = 2

query IIII
SELECT * FROM dl.s
----
1	100	10	11

# the columns of the user have file stats
query III
SELECT t.table_name, c.column_name, count(*) > 0
FROM __ducklake_metadata_dl.ducklake_file_column_stats st
JOIN __ducklake_metadata_dl.ducklake_column c USING (table_id, column_id)
JOIN __ducklake_metadata_dl.ducklake_table t USING (table_id)
WHERE c.column_name LIKE '\_ducklake\_%' ESCAPE '\' AND c.end_snapshot IS NULL AND t.end_snapshot IS NULL
GROUP BY ALL ORDER BY ALL
----
s	_ducklake_internal_row_id	true
s	_ducklake_internal_row_id_1	true
s	_ducklake_internal_snapshot_id	true
t	_ducklake_internal_row_id	true
