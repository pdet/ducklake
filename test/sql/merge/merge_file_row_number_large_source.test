# name: test/sql/merge/merge_file_row_number_large_source.test
# description: a delete that joins another DuckLake table on file_row_number deletes the rows of its own table
# group: [merge]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/merge_file_row_number_large_source', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.s (a INTEGER)

statement ok
INSERT INTO lake.s SELECT range FROM range(100000)

# the large source is scanned before the target
statement ok
CREATE TABLE lake.t (a INTEGER)

statement ok
INSERT INTO lake.t VALUES (10), (20)

query I
MERGE INTO lake.t AS t USING lake.s AS s ON t.file_row_number = s.file_row_number WHEN MATCHED THEN DELETE
----
2

query I
SELECT count(*) FROM lake.t
----
0

statement ok
INSERT INTO lake.t VALUES (30), (40)

query I
MERGE INTO lake.t AS t USING lake.s AS s ON t.file_row_number = s.file_row_number WHEN MATCHED THEN UPDATE SET a = t.a + s.a
----
2

query I
SELECT a FROM lake.t ORDER BY a
----
30
41

query I
DELETE FROM lake.t USING lake.s WHERE t.file_row_number = s.file_row_number AND s.a = 0
----
1

query I
SELECT a FROM lake.t
----
41

# both sides scan the target
query I
MERGE INTO lake.t AS t USING (SELECT file_row_number AS row_number FROM lake.t) AS s ON t.file_row_number = s.row_number WHEN MATCHED THEN DELETE
----
1

query II
SELECT (SELECT count(*) FROM lake.t), (SELECT count(*) FROM lake.s)
----
0	100000
