# name: test/sql/stats/nan_column_stats.test
# description: FLOAT and DOUBLE columns with NaN keep their min/max statistics, with NaN as the max
# group: [stats]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/nan_column_stats')

foreach type FLOAT DOUBLE

foreach inlining 10 0

statement ok
CREATE OR REPLACE TABLE dl.t (x ${type}) WITH (data_inlining_row_limit = ${inlining})

statement ok
INSERT INTO dl.t VALUES ('nan'), (42), (-42)

query II
SELECT ((stats(x)).min)::${type} = -42, isnan(((stats(x)).max)::${type}) FROM dl.t LIMIT 1
----
true	true

# NaN is greater than every other value, so the max must not prune it
query III
SELECT count(*) FILTER (x > 100), count(*) FILTER (x < -100), count(*) FILTER (x >= -42) FROM dl.t
----
1	0	3

statement ok
CREATE OR REPLACE TABLE dl.t (x ${type}) WITH (data_inlining_row_limit = ${inlining})

statement ok
INSERT INTO dl.t VALUES ('nan')

query II
SELECT count(*) FILTER (x > 100), count(*) FILTER (x < 100) FROM dl.t
----
1	0

statement ok
CREATE OR REPLACE TABLE dl.t (x ${type}) WITH (data_inlining_row_limit = ${inlining})

statement ok
INSERT INTO dl.t VALUES (1), (2)

query II
SELECT ((stats(x)).min)::${type}, ((stats(x)).max)::${type} FROM dl.t LIMIT 1
----
1.0	2.0

endloop

# inlined data keeps NaN as both bounds of a column with only NaN
statement ok
CREATE OR REPLACE TABLE dl.t (x ${type}) WITH (data_inlining_row_limit = 10)

statement ok
INSERT INTO dl.t VALUES ('nan')

query II
SELECT isnan(((stats(x)).min)::${type}), isnan(((stats(x)).max)::${type}) FROM dl.t LIMIT 1
----
true	true

endloop
