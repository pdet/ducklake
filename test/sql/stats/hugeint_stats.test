# name: test/sql/stats/hugeint_stats.test
# description: HUGEINT and UHUGEINT columns give their bounds to DuckDB
# group: [stats]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/hugeint_stats.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/hugeint_stats', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (h HUGEINT, u UHUGEINT)

statement ok
INSERT INTO dl.t VALUES (1, 2), (10, 20)

query IIII
SELECT (stats(h)).min, (stats(h)).max, (stats(u)).min, (stats(u)).max FROM dl.t LIMIT 1
----
1	10	2	20

query I
SELECT bitstring_agg(u) FROM dl.t
----
1000000000000000001

# parquet keeps no bounds for these types, so a flushed table has none either
statement ok
CALL ducklake_flush_inlined_data('dl')

query II
SELECT (stats(h)).min IS NULL, (stats(u)).max IS NULL FROM dl.t LIMIT 1
----
true	true

query I
SELECT count(*) FROM dl.t WHERE h > 5 AND u > 10
----
1

# a missing bound does not leave an empty range
statement ok
CREATE TABLE dl.one_bound (u UHUGEINT)

statement ok
INSERT INTO dl.one_bound VALUES (0), (20)

statement ok
UPDATE __ducklake_metadata_dl.ducklake_table_column_stats SET max_value = NULL
WHERE table_id = (SELECT table_id FROM ducklake_table_info('dl') WHERE table_name = 'one_bound')

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/hugeint_stats', DATA_INLINING_ROW_LIMIT 10)

query I
SELECT count(*) FROM dl.one_bound WHERE u > 10
----
1
