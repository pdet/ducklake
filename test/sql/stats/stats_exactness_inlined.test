# name: test/sql/stats/stats_exactness_inlined.test
# description: inlined data produces exact min/max stats, flushing demotes strings to the COPY path
# group: [stats]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/stats_exactness_inlined.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/stats_exactness_inlined_files', METADATA_CATALOG 'dl', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE ducklake.test(i INTEGER, s VARCHAR);

statement ok
INSERT INTO ducklake.test VALUES (1, 'hello'), (2, 'world');

# inlined values are stored verbatim - their stats are exact
query IIII
SELECT min_value, max_value, min_is_exact, max_is_exact FROM dl.ducklake_table_column_stats ORDER BY column_id
----
1	2	true	true
hello	world	true	true

statement ok
CALL ducklake_flush_inlined_data('ducklake')

# the flushed parquet file goes through the COPY path, which does not know string exactness yet
query IIII
SELECT min_value, max_value, min_is_exact, max_is_exact FROM dl.ducklake_file_column_stats ORDER BY column_id
----
1	2	true	true
hello	world	false	false

# merging the flushed file demotes the string bounds on a tie
query IIII
SELECT min_value, max_value, min_is_exact, max_is_exact FROM dl.ducklake_table_column_stats ORDER BY column_id
----
1	2	true	true
hello	world	false	false
