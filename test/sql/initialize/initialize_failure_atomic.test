# name: test/sql/initialize/initialize_failure_atomic.test
# description: a failure while creating the metadata tables of a new DuckLake leaves none of them behind
# group: [initialize]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/initialize_failure_atomic.db

test-env DATA_PATH {TEST_DIR}

# a table that the initialization creates late already exists
statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS meta

statement ok
CREATE TABLE meta.ducklake_column_mapping(mapping_id BIGINT);

statement ok
DETACH meta

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/initialize_failure_atomic')
----
Failed to initialize DuckLake

statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS meta

query I
SELECT table_name FROM duckdb_tables() WHERE database_name = 'meta' AND table_name LIKE 'ducklake_%' ORDER BY ALL
----
ducklake_column_mapping

statement ok
DROP TABLE meta.ducklake_column_mapping

statement ok
DETACH meta

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/initialize_failure_atomic')

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

query I
SELECT i FROM dl.t
----
42

statement ok
DETACH dl
