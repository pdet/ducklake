# name: test/sql/encryption/encryption_deletion_vectors.test
# description: An encrypted catalog writes its deletes to encrypted parquet files, also with deletion vectors enabled
# group: [encryption]

require ducklake

require parquet

require httpfs

test-env DUCKLAKE_CONNECTION {TEST_DIR}/encryption_deletion_vectors.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/encryption_deletion_vectors', METADATA_CATALOG 'encryption_deletion_vectors_meta', ENCRYPTED, DATA_INLINING_ROW_LIMIT 10)

statement ok
CALL dl.set_option('write_deletion_vectors', true)

statement ok
CREATE TABLE dl.t AS SELECT i FROM range(1000) t(i)

statement ok
DELETE FROM dl.t WHERE i % 2 = 0

# deletes of inlined rows are written to a delete file by the flush
statement ok
INSERT INTO dl.t VALUES (1000), (1001)

statement ok
DELETE FROM dl.t WHERE i = 1000

statement ok
CALL ducklake_flush_inlined_data('dl')

query II
SELECT count(*), sum(i) FROM dl.t
----
501	251001

query IIII
SELECT count(*), count(DISTINCT format), min(format), bool_and(encryption_key IS NOT NULL)
FROM encryption_deletion_vectors_meta.ducklake_delete_file
----
2	1	parquet	true

query I
SELECT count(*) FROM glob('{DATA_PATH}/encryption_deletion_vectors/**/*.puffin')
----
0

statement error
SELECT * FROM '{DATA_PATH}/encryption_deletion_vectors/**/*-delete.parquet'
----
encrypted

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/encryption_deletion_vectors')

query II
SELECT count(*), sum(i) FROM dl.t
----
501	251001
