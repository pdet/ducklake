# name: test/sql/deletion_inlining/inlined_file_deletions_multiple_flush.test
# description: test inlined data deletions with multiple flush cycles
# group: [deletion_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__

statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/inlined_deletions_multi_flush', DATA_INLINING_ROW_LIMIT 10)

statement ok
use ducklake

statement ok
CREATE TABLE t1 (a INTEGER)

statement ok
INSERT INTO t1 VALUES (1), (2), (3), (4), (5), (6), (7), (8)

statement ok
DELETE FROM t1 WHERE a = 2

statement ok
DELETE FROM t1 WHERE a = 4

# when we flush we have one data file and one deletion file
statement ok
CALL ducklake_flush_inlined_data('ducklake')

query I
SELECT COUNT(*) FROM __ducklake_metadata_ducklake.ducklake_data_file WHERE table_id = 1
----
1

query I
SELECT COUNT(*) FROM __ducklake_metadata_ducklake.ducklake_delete_file WHERE table_id = 1
----
1

query I
SELECT delete_count FROM __ducklake_metadata_ducklake.ducklake_delete_file WHERE table_id = 1
----
2

query I
SELECT * FROM t1 ORDER BY a
----
1
3
5
6
7
8

statement ok
INSERT INTO t1 VALUES (10), (11), (12)

statement ok
DELETE FROM t1 WHERE a = 11

query I
SELECT COUNT(*) FROM t1
----
8

query I
SELECT COUNT(*) FROM __ducklake_metadata_ducklake.ducklake_inlined_data_tables WHERE table_id = 1
----
1

statement ok
CALL ducklake_flush_inlined_data('ducklake')

query I
SELECT COUNT(*) FROM __ducklake_metadata_ducklake.ducklake_data_file WHERE table_id = 1
----
2

query I
SELECT COUNT(*) FROM __ducklake_metadata_ducklake.ducklake_delete_file WHERE table_id = 1
----
2

query I
SELECT delete_count FROM __ducklake_metadata_ducklake.ducklake_delete_file WHERE table_id = 1 ORDER BY delete_file_id
----
2
1

query I
SELECT COUNT(*) FROM t1
----
8

query I
SELECT * FROM t1 ORDER BY a
----
1
3
5
6
7
8
10
12

# Check Time Travel
query I
SELECT COUNT(*) FROM t1 AT (version => 2)
----
8

query I
SELECT COUNT(*) FROM t1 AT (version => 5)
----
6

query I
SELECT COUNT(*) FROM t1 AT (version => 6)
----
9

query I
SELECT COUNT(*) FROM t1 AT (version => 7)
----
8

query I
SELECT COUNT(*) FROM t1 AT (version => 8)
----
8
