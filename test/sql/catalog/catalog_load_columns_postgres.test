# name: test/sql/catalog/catalog_load_columns_postgres.test
# description: Postgres catalogs read the column rows live at the snapshot in Postgres when loading the catalog
# group: [catalog]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/catalog_load_columns_postgres')

statement ok
CREATE TABLE ducklake.t (a INTEGER, b INTEGER)

statement ok
ALTER TABLE ducklake.t DROP COLUMN b

statement ok
DETACH ducklake

statement ok
CALL enable_logging('DuckLakeMetadata', storage = 'memory')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/catalog_load_columns_postgres')

query I
SELECT column_name FROM (DESCRIBE ducklake.t)
----
a

statement ok
USE ducklake

query I
SELECT CASE WHEN (SELECT catalog_type FROM settings()) = 'postgres' THEN
	(SELECT count(*) > 0 FROM duckdb_logs_parsed('DuckLakeMetadata')
	 WHERE regexp_replace(query, '\s+', ' ', 'g')
	       LIKE '%LEFT JOIN (SELECT * FROM postgres_query(%ducklake_column WHERE%) col USING (table_id)%')
	ELSE true END
----
true
