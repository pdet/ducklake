# name: test/sql/catalog/sqlite_native_head_and_stats.test
# description: a SQLite catalog reads its head snapshot and its table stats in one statement each that SQLite runs, reading what a DuckDB catalog of the same lake reads
# group: [catalog]

require ducklake

require parquet

require sqlite_scanner

require json

test-env DATA_PATH {TEST_DIR}

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'}

statement ok
ATTACH 'ducklake:sqlite:{TEST_DIR}/{BASE_TEST_NAME}.db' AS sl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_sqlite', DATA_INLINING_ROW_LIMIT 0)

statement ok
ATTACH 'ducklake:{TEST_DIR}/{BASE_TEST_NAME}_duckdb.db' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_duckdb', DATA_INLINING_ROW_LIMIT 0)

# the same lake in both catalogs
foreach lake sl dl

statement ok
CREATE TABLE {lake}.t (i INTEGER, s VARCHAR, d DOUBLE)

statement ok
INSERT INTO {lake}.t VALUES (1, 'a', 1.5), (2, 'b', 2.5), (3, 'c', 3.5)

statement ok
INSERT INTO {lake}.t VALUES (4, NULL, 4.5), (5, 'e', 5.5)

statement ok
DELETE FROM {lake}.t WHERE i = 2

endloop

statement ok
CALL enable_logging('DuckLakeMetadata', storage => 'memory')

query III
SELECT count(*), sum(i), count(s) FROM sl.t
----
4	13	3

query III
SELECT count(*), sum(i), count(s) FROM dl.t
----
4	13	3

statement ok
CALL disable_logging()

# SQLite ran the head read and the stats read, one typed statement each
query II
SELECT count(*) FILTER (query LIKE '%MAX(snapshot_id)%') > 0, count(*) FILTER (query LIKE '%ducklake_table_stats%') > 0
FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE catalog = 'sl' AND query LIKE 'SELECT % FROM sqlite_query(%column_types := %'
----
true	true

# the scanner read neither the head nor the stats of the SQLite catalog
query I
SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE catalog = 'sl' AND query NOT LIKE '%sqlite_query(%'
  AND (query LIKE '%MAX(snapshot_id)%' OR query LIKE '%ducklake_table_stats%')
----
0

# the DuckDB catalog read both through its own SQL
query II
SELECT count(*) FILTER (query LIKE '%MAX(snapshot_id)%') > 0, count(*) FILTER (query LIKE '%ducklake_table_stats%') > 0
FROM duckdb_logs_parsed('DuckLakeMetadata') WHERE catalog = 'dl' AND query NOT LIKE '%sqlite_query(%'
----
true	true

# both catalogs read the same head and the same stats
foreach lake sl dl

query I
SELECT id FROM {lake}.current_snapshot()
----
4

query II
SELECT record_count, next_row_id FROM __ducklake_metadata_{lake}.ducklake_table_stats
----
5	5

query I
SELECT stats(i) FROM {lake}.t LIMIT 1
----
<REGEX>:.*has_null.*false.*max.*5.*min.*1.*

query I
SELECT stats(s) FROM {lake}.t LIMIT 1
----
<REGEX>:.*has_null.*true.*max.*e.*min.*a.*

# the optimizer reads the bounds of the stats
query II
EXPLAIN ANALYZE SELECT * FROM {lake}.t WHERE i = 9
----
analyzed_plan	<REGEX>:.*EMPTY_RESULT.*

endloop

# a 1.0 catalog has no exactness columns, its stats statement reads the ten columns it has
statement ok
ATTACH 'ducklake:sqlite:{TEST_DIR}/{BASE_TEST_NAME}_10.db' AS sl10 (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_sqlite_10', DATA_INLINING_ROW_LIMIT 0, DUCKLAKE_VERSION '1.0')

statement ok
CREATE TABLE sl10.t (i INTEGER, s VARCHAR)

statement ok
INSERT INTO sl10.t VALUES (1, 'a'), (2, NULL), (3, 'c')

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('DuckLakeMetadata', storage => 'memory')

query III
SELECT count(*), sum(i), count(s) FROM sl10.t
----
3	6	2

statement ok
CALL disable_logging()

query III
SELECT count(*) FILTER (query LIKE '%MAX(snapshot_id)%') > 0,
       count(*) FILTER (query LIKE '%ducklake_table_stats%' AND query NOT LIKE '%min_is_exact%') > 0,
       count(*) FILTER (query LIKE '%ducklake_table_stats%' AND query LIKE '%min_is_exact%')
FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE catalog = 'sl10' AND query LIKE 'SELECT % FROM sqlite_query(%column_types := %'
----
true	true	0

statement ok
DETACH sl10

# a failing native read reports the error of the read with the statement SQLite ran
statement ok
ATTACH '{TEST_DIR}/{BASE_TEST_NAME}.db' AS raw (TYPE sqlite)

statement ok
DROP TABLE raw.ducklake_snapshot

statement ok
DETACH raw

statement error
SELECT count(*), sum(i), count(s) FROM sl.t
----
<REGEX>:.*Failed to query most recent snapshot for DuckLake.*Statement: SELECT .* FROM sqlite_query\(.*ducklake_snapshot.*
