# name: test/sql/tags/postgres_tags_guard.test
# description: tag commits on Postgres carry an existence guard, also under READ COMMITTED where the mutex only waits, in a schema whose name needs quoting, and an error no retry can fix is not retried
# group: [tags]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CI

require-env DUCKLAKE_CONNECTION

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS pg

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA IF EXISTS "tags''$$guard" CASCADE')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl
(DATA_PATH '{DATA_PATH}/tags_guard', METADATA_SCHEMA 'tags''$$guard', META_ISOLATION_LEVEL 'READ COMMITTED')

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

statement ok
INSERT INTO dl.t VALUES (2)

# the commit batch of a tag carries the existence guard
statement ok
CALL ducklake_create_tag('dl', 'two', version => 2)

statement ok
CALL ducklake_create_tag('dl', 'three', version => 3)

query II
SELECT tag_name, snapshot_id FROM ducklake_tags('dl') ORDER BY tag_name
----
three	3
two	2

query I
SELECT i FROM dl.t AT (VERSION => 'two')
----
1

# the expiry takes the mutex before it reads its candidates
query I
SELECT snapshot_id FROM ducklake_expire_snapshots('dl', versions => [1, 2])
----
1

statement ok
CALL ducklake_drop_tag('dl', 'two')

query I
SELECT snapshot_id FROM ducklake_expire_snapshots('dl', versions => [1, 2])
----
2

query I
SELECT value FROM dl.options() WHERE option_name = 'catalog_mutex'
----
4

statement ok
DETACH dl

# a read-only session fails the tag commit at once
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION} options=-cdefault_transaction_read_only=on' AS dl_ro
(DATA_PATH '{DATA_PATH}/tags_guard', METADATA_SCHEMA 'tags''$$guard')

statement error
CALL ducklake_create_tag('dl_ro', 'read_only', version => 3)
----
<!REGEX>:.*Exceeded the maximum retry count.*

statement error
CALL ducklake_create_tag('dl_ro', 'read_only', version => 3)
----
read-only transaction

statement ok
DETACH dl_ro

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA "tags''$$guard" CASCADE')

statement ok
DETACH pg
