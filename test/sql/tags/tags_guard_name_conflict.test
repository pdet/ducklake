# name: test/sql/tags/tags_guard_name_conflict.test
# description: a tag named like the error of the commit guard fails its conflict at once, without a retry
# group: [tags]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/tags_guard_name_conflict_files')

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
SET immediate_transaction_mode=true

# the first retry, which a stale view of the conflict needs, waits at most 100 ms, a second one at least 5 seconds
statement ok con2
SET ducklake_max_retry_count = 2

statement ok con2
SET ducklake_retry_wait_ms = 100

statement ok con2
SET ducklake_retry_backoff = 100

statement ok con1
BEGIN

statement ok con2
BEGIN

statement ok con1
CALL ducklake_create_tag('dl', 'the snapshot of a new tag was expired by another transaction')

statement ok con2
CALL ducklake_create_tag('dl', 'the snapshot of a new tag was expired by another transaction')

statement ok con1
COMMIT

statement ok
SET VARIABLE started = epoch_ms(now())

statement error con2
COMMIT
----
Transaction conflict

query I
SELECT epoch_ms(now()) - getvariable('started') < 3000
----
true

query I
SELECT COUNT(*) FROM ducklake_tags('dl')
----
1
