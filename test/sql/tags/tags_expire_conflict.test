# name: test/sql/tags/tags_expire_conflict.test
# description: an expiry that started before a concurrent tag commit fails instead of expiring the tagged snapshot
# group: [tags]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/tags_expire_conflict_files')

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

statement ok
INSERT INTO dl.t VALUES (2)

# the expiry transaction starts before the tag is committed
statement ok con2
BEGIN

query I con2
SELECT COUNT(*) FROM dl.t
----
2

statement ok con1
CALL ducklake_create_tag('dl', 'keep', version => 2)

statement error con2
CALL ducklake_expire_snapshots('dl', versions => [2])
----
a concurrent transaction tagged or expired snapshots

statement ok con2
ROLLBACK

query I
SELECT COUNT(*) FROM ducklake_snapshots('dl') WHERE snapshot_id = 2
----
1

# the retry sees the tag
query I
SELECT COUNT(*) FROM ducklake_expire_snapshots('dl', versions => [2])
----
0

query I
SELECT COUNT(*) FROM ducklake_snapshots('dl') WHERE snapshot_id = 2
----
1
