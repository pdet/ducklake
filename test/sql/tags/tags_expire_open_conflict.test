# name: test/sql/tags/tags_expire_open_conflict.test
# description: a tag commit conflicts with an expiry that holds the catalog mutex in an open transaction
# group: [tags]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/tags_expire_open_conflict_files')

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

statement ok
INSERT INTO dl.t VALUES (2)

statement ok con2
SET ducklake_max_retry_count = 1

statement ok con2
SET ducklake_retry_wait_ms = 10

# the open expiry holds the mutex, so the tag commit retries until it gives up
statement ok con1
BEGIN

statement ok con1
CALL ducklake_expire_snapshots('dl', versions => [1])

statement error con2
CALL ducklake_create_tag('dl', 'contended', version => 2)
----
<REGEX>:.*Exceeded the maximum retry count of 1.*(Conflict on update|database is locked).*

statement ok con1
COMMIT

statement ok con2
CALL ducklake_create_tag('dl', 'contended', version => 2)

query I
SELECT COUNT(*) FROM ducklake_snapshots('dl') WHERE snapshot_id = 1
----
0

# an expiry that selects nothing still holds the mutex until it rolls back
statement ok con1
BEGIN

query I con1
SELECT COUNT(*) FROM ducklake_expire_snapshots('dl', versions => [2])
----
0

statement error con2
CALL ducklake_create_tag('dl', 'kept', version => 2)
----
<REGEX>:.*Exceeded the maximum retry count of 1.*(Conflict on update|database is locked).*

statement ok con1
ROLLBACK

statement ok con2
CALL ducklake_create_tag('dl', 'kept', version => 2)

query II
SELECT tag_name, snapshot_id FROM ducklake_tags('dl') ORDER BY tag_name
----
contended	2
kept	2

# a rolled back expiry keeps its snapshot
statement ok con1
BEGIN

query I con1
SELECT snapshot_id FROM ducklake_expire_snapshots('dl', versions => [3])
----
3

statement ok con1
ROLLBACK

query I
SELECT COUNT(*) FROM ducklake_snapshots('dl') WHERE snapshot_id = 3
----
1
