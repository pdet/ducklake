# name: test/sql/tags/postgres_tags_mutex_connection_loss.test
# description: an expiry that loses its Postgres connection before it takes the catalog mutex expires nothing
# group: [tags]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CI

require-env DUCKLAKE_CONNECTION

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS pg

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA IF EXISTS tags_mutex_connection_loss CASCADE')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION} application_name=tags_mutex_connection_loss' AS dl
(DATA_PATH '{DATA_PATH}/tags_mutex_connection_loss', METADATA_SCHEMA 'tags_mutex_connection_loss')

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

statement ok
INSERT INTO dl.t VALUES (2)

statement ok
BEGIN

query I
SELECT count(*) FROM dl.t
----
2

# the metadata connections of the lake are gone before the expiry
query I
SELECT count(*) > 0 AND bool_and(terminated) FROM postgres_query('pg',
'SELECT pg_terminate_backend(pid, 5000) AS terminated FROM pg_stat_activity
WHERE datname = current_database() AND application_name = ''tags_mutex_connection_loss''')
----
true

statement error
CALL ducklake_expire_snapshots('dl', versions => [1])
----
<REGEX>:.*Failed to take the catalog mutex in DuckLake.*(connection|server closed).*

statement maybe
ROLLBACK
----
connection

query I
SELECT count(*) FROM ducklake_snapshots('dl') WHERE snapshot_id = 1
----
1

# the next expiry reconnects and takes the mutex
query I
SELECT snapshot_id FROM ducklake_expire_snapshots('dl', versions => [1])
----
1

statement ok
DETACH dl

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA tags_mutex_connection_loss CASCADE')

statement ok
DETACH pg
