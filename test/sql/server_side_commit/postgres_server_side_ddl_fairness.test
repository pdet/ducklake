# name: test/sql/server_side_commit/postgres_server_side_ddl_fairness.test
# description: Lock-free Postgres commit batches take the batch key shared, so sequenced DDL is not starved
# group: [server_side_commit]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CI

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'dbname=ducklakedb' AS pg (TYPE postgres)

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA IF EXISTS server_side_fairness CASCADE')

statement ok
ATTACH 'ducklake:postgres:dbname=ducklakedb' AS dl
(DATA_PATH '{DATA_PATH}/server_side_fairness', METADATA_SCHEMA 'server_side_fairness')

query I
SELECT server_side_retries FROM ducklake_settings('dl')
----
true

statement ok
CREATE TABLE dl.t (session INTEGER, i INTEGER)

statement ok
CREATE TABLE dl.m (i INTEGER)

# the shared take leads the first attempt's batch, the sequenced retry has none
statement ok
CALL enable_logging('PostgresQueryLog')

statement ok
INSERT INTO dl.t VALUES (-1, 0)

statement ok con1
BEGIN

statement ok con1
CREATE TABLE dl.a (i INTEGER)

statement ok con2
CREATE TABLE dl.b (i INTEGER)

statement ok con1
COMMIT

statement ok
CALL disable_logging()

query I
SELECT count(*) FROM duckdb_logs_parsed('PostgresQueryLog')
WHERE starts_with(query, 'DO $dlshr$') AND contains(query, 'pg_advisory_xact_lock_shared(1145848642, ')
AND contains(query, '$dlshr$;' || chr(10) || 'INSERT INTO "server_side_fairness".ducklake_snapshot VALUES')
----
3

# the sequencer takes the commit key, then the batch key
query I
SELECT count(*) FROM duckdb_logs_parsed('PostgresQueryLog')
WHERE regexp_matches(query, '^SET TRANSACTION ISOLATION LEVEL READ COMMITTED;.*pg_advisory_xact_lock\(1145848659, .*'
                            || 'pg_advisory_xact_lock\(1145848642, ', 's')
----
1

query I
WITH pg_log AS (
	SELECT row_number() OVER () AS seq, transaction_id, query FROM duckdb_logs_parsed('PostgresQueryLog')
), sequencer AS (
	SELECT transaction_id FROM pg_log WHERE query LIKE 'SET TRANSACTION ISOLATION LEVEL READ COMMITTED;%'
)
SELECT list(CASE WHEN p.query LIKE 'INSERT INTO "server_side_fairness".ducklake_snapshot VALUES%' THEN 'batch'
                 ELSE 'other' END ORDER BY p.seq)
FROM pg_log p JOIN sequencer s USING (transaction_id)
WHERE contains(p.query, 'ducklake_snapshot VALUES') OR contains(p.query, 'pg_advisory_xact_lock_shared')
----
[batch]

# no shared take with the setting off
statement ok
SET ducklake_server_side_retries = false

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('PostgresQueryLog')

statement ok
INSERT INTO dl.t VALUES (-1, 1)

statement ok
CALL disable_logging()

statement ok
RESET ducklake_server_side_retries

query II
SELECT count(*) FILTER (WHERE query LIKE 'INSERT INTO "server_side_fairness".ducklake_snapshot VALUES%'),
       count(*) FILTER (WHERE contains(query, 'pg_advisory'))
FROM duckdb_logs_parsed('PostgresQueryLog')
----
1	0

# no shared take without the server-side commit
statement ok
DETACH dl

statement ok
ATTACH 'ducklake:postgres:dbname=ducklakedb options=-cdefault_transaction_isolation=serializable' AS dl
(DATA_PATH '{DATA_PATH}/server_side_fairness', METADATA_SCHEMA 'server_side_fairness')

query I
SELECT server_side_retries FROM ducklake_settings('dl')
----
false

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('PostgresQueryLog')

statement ok
INSERT INTO dl.t VALUES (-1, 2)

statement ok
CALL disable_logging()

query II
SELECT count(*) FILTER (WHERE query LIKE 'INSERT INTO "server_side_fairness".ducklake_snapshot VALUES%'),
       count(*) FILTER (WHERE contains(query, 'pg_advisory'))
FROM duckdb_logs_parsed('PostgresQueryLog')
----
1	0

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:postgres:dbname=ducklakedb' AS dl
(DATA_PATH '{DATA_PATH}/server_side_fairness', METADATA_SCHEMA 'server_side_fairness')

# a held batch key is waited for within the budget, then the batch runs without it
statement ok
SET ducklake_retry_wait_ms = 500

statement ok
SET ducklake_retry_backoff = 1

statement ok
SET ducklake_max_retry_count = 4

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('PostgresQueryLog')

# the commit key alone does not block it
statement ok con3
BEGIN

statement ok con3
CALL postgres_execute('pg', 'SELECT pg_advisory_xact_lock(1145848659,
(SELECT oid FROM pg_namespace WHERE nspname = ''server_side_fairness'')::INTEGER)', prepare=FALSE)

statement ok
INSERT INTO dl.t VALUES (-1, 3)

statement ok con3
COMMIT

statement ok con3
BEGIN

statement ok con3
CALL postgres_execute('pg', 'SELECT pg_advisory_xact_lock(1145848642,
(SELECT oid FROM pg_namespace WHERE nspname = ''server_side_fairness'')::INTEGER)', prepare=FALSE)

statement ok
INSERT INTO dl.t VALUES (-1, 4)

# a transaction with written rows does not wait
statement ok con1
BEGIN

statement ok con1
CALL dl.set_option('data_inlining_row_limit', 10, table_name => 'm')

statement ok con1
INSERT INTO dl.t VALUES (-1, 5)

statement ok con1
COMMIT

statement ok
CALL disable_logging()

query I
SELECT list(CASE WHEN duration_ms >= 1500 AND duration_ms < 10000 THEN 'waited' WHEN duration_ms < 1500 THEN 'free'
                 ELSE duration_ms::VARCHAR END ORDER BY timestamp)
FROM duckdb_logs_parsed('PostgresQueryLog')
WHERE starts_with(query, 'DO $dlshr$')
----
[free, waited, free]

# a sequenced retry that cannot get the batch key runs unsequenced
statement ok
SET ducklake_retry_wait_ms = 100

statement ok
SET ducklake_max_retry_count = 3

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging(level = 'info')

statement ok con1
BEGIN

statement ok con1
CREATE TABLE dl.c (i INTEGER)

statement ok con2
CREATE TABLE dl.d (i INTEGER)

statement ok con1
COMMIT

statement ok con3
COMMIT

statement ok
CALL disable_logging()

query I
SELECT count(*) FROM duckdb_logs WHERE regexp_matches(message,
'^DuckLake commit attempt 1 did not get the commit keys within [0-9]+ ms and runs unsequenced$')
----
1

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'dl' AND table_name IN ('c', 'd')
----
2

statement ok
RESET ducklake_retry_wait_ms

statement ok
RESET ducklake_retry_backoff

statement ok
RESET ducklake_max_retry_count

# DDL keeps committing next to a stream of appends
concurrentforeach session 0 1 2 3 4 5

loop i 0 40

onlyif session<5
statement ok
INSERT INTO dl.t VALUES ({session}, {i})

endloop

loop i 0 10

onlyif session=5
statement ok
COMMENT ON TABLE dl.m IS 'comment {i}'

onlyif session=5
statement ok
CREATE TABLE dl.ddl_{i} (i INTEGER)

endloop

endloop

query II
SELECT count(*), count(DISTINCT (session, i)) FROM dl.t WHERE session >= 0
----
200	200

query II
SELECT count(*) = count(DISTINCT rowid), max(rowid) + 1 = count(*) FROM dl.t
----
true	true

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'dl' AND table_name LIKE 'ddl_%'
----
10

query I
SELECT comment FROM duckdb_tables() WHERE database_name = 'dl' AND table_name = 'm'
----
comment 9

query I
SELECT max(snapshot_id) - min(snapshot_id) + 1 = count(*)
FROM postgres_query('pg', 'SELECT snapshot_id FROM server_side_fairness.ducklake_snapshot')
----
true

statement ok
DETACH dl

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA server_side_fairness CASCADE')
