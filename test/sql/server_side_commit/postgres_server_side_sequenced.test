# the retry is stamped after its key wait
query II
SELECT max(snapshot_time) - min(snapshot_time) >= INTERVAL 600 MILLISECONDS, arg_max(snapshot_time, snapshot_id) = max(snapshot_time)
FROM postgres_query('pg', 'SELECT snapshot_id, snapshot_time FROM server_side_sequenced.ducklake_snapshot
ORDER BY snapshot_id DESC LIMIT 2')
----
true	true

