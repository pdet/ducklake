# a first attempt without PL/pgSQL turns sequencing off
statement ok
CALL postgres_execute('pg', 'GRANT USAGE ON LANGUAGE plpgsql TO PUBLIC')

statement ok
CALL postgres_execute('pg', 'DROP ROLE IF EXISTS ducklake_sequenced_role')

statement ok
CALL postgres_execute('pg', 'CREATE ROLE ducklake_sequenced_role')

statement ok
CALL postgres_execute('pg', 'GRANT USAGE, CREATE ON SCHEMA server_side_sequenced TO ducklake_sequenced_role')

statement ok
CALL postgres_execute('pg', 'GRANT ALL ON ALL TABLES IN SCHEMA server_side_sequenced TO ducklake_sequenced_role')

statement ok
ATTACH 'ducklake:postgres:dbname=ducklakedb options=-crole=ducklake_sequenced_role' AS dl
(DATA_PATH '{DATA_PATH}/server_side_sequenced', METADATA_SCHEMA 'server_side_sequenced')

query I
SELECT server_side_retries FROM ducklake_settings('dl')
----
true

# a failed run is undone by the GRANT above
statement ok
CALL postgres_execute('pg', 'REVOKE USAGE ON LANGUAGE plpgsql FROM PUBLIC')

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging(level = 'warning')

