# an unsequenced retry that loses again exhausts cleanly
statement ok
SET ducklake_max_retry_count = 1

statement ok
CREATE TABLE dl.w (i INTEGER)

statement ok
CALL postgres_execute('pg', 'CREATE FUNCTION server_side_sequenced.lose() RETURNS TRIGGER LANGUAGE plpgsql AS $$
BEGIN RAISE unique_violation USING MESSAGE = ''duplicate key value violates unique constraint "ducklake_snapshot_pkey"'';
END $$')

statement ok con3
BEGIN

statement ok con3
CALL postgres_execute('pg', 'SELECT pg_advisory_xact_lock(1145848659,
(SELECT oid FROM pg_namespace WHERE nspname = ''server_side_sequenced'')::INTEGER)', prepare=FALSE)

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging(level = 'info')

statement ok con1
BEGIN

statement ok con1
INSERT INTO dl.w SELECT range FROM range(100)

statement ok con2
INSERT INTO dl.w VALUES (-1)

statement ok
CALL postgres_execute('pg', 'CREATE TRIGGER lose BEFORE INSERT ON server_side_sequenced.ducklake_snapshot
FOR EACH ROW EXECUTE FUNCTION server_side_sequenced.lose()')

statement error con1
COMMIT
----
<REGEX>:.*Failed to commit DuckLake transaction.*Exceeded the maximum retry count of 1 set by the ducklake_max_retry_count setting.*

statement ok con3
COMMIT

statement ok
CALL postgres_execute('pg', 'DROP TRIGGER lose ON server_side_sequenced.ducklake_snapshot')

statement ok
CALL disable_logging()

