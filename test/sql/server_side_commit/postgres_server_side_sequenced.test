query I
SELECT bool_and(snapshot_time >= previous_time) FROM (
	SELECT snapshot_time, lag(snapshot_time) OVER (ORDER BY snapshot_id) AS previous_time
	FROM postgres_query('pg', 'SELECT snapshot_id, snapshot_time FROM server_side_sequenced.ducklake_snapshot'))
