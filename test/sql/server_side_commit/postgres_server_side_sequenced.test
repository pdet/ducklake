BEGIN

statement ok con1
INSERT INTO dl.t VALUES (7)

statement ok con2
INSERT INTO dl.t VALUES (8)

statement ok con1
COMMIT

statement ok
CALL postgres_execute('pg', 'GRANT USAGE ON LANGUAGE plpgsql TO PUBLIC')

