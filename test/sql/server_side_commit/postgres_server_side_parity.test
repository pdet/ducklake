# bounds with a placeholder text stay literal
statement ok
ATTACH 'ducklake:postgres:dbname=ducklakedb' AS lit (DATA_PATH '{DATA_PATH}/parity_lit', METADATA_SCHEMA 'parity_lit')

statement ok
CREATE TABLE lit.t (s VARCHAR)

statement ok
SET ducklake_debug_relative_commit = true

statement ok
INSERT INTO lit.t VALUES ('{SNAPSHOT_ID}a'), ('{METADATA_CATALOG}c')

statement ok
INSERT INTO lit.t SELECT '{SCHEMA_VERSION}' || i FROM range(20) t(i)

statement ok
SET ducklake_debug_relative_commit = false

statement ok
CALL pg_clear_cache()

query II
SELECT min_value, max_value FROM pg.parity_lit.ducklake_table_column_stats
----
{METADATA_CATALOG}c	{SNAPSHOT_ID}a

query II
SELECT min_value, max_value FROM pg.parity_lit.ducklake_file_column_stats
----
{SCHEMA_VERSION}0	{SCHEMA_VERSION}9

query I
SELECT count(*) FROM lit.t WHERE s IN ('{SNAPSHOT_ID}a', '{METADATA_CATALOG}c')
----
2

# absolute commits still rewrite placeholder text in bounds
statement ok
INSERT INTO lit.t VALUES ('{SNAPSHOT_ID}b')

statement ok
CALL pg_clear_cache()

query II
SELECT min_value, max_value FROM pg.parity_lit.ducklake_table_column_stats
----
"parity_lit"c	4b

query I
SELECT s FROM lit.t WHERE s LIKE '%b'
----
{SNAPSHOT_ID}b

# debug commits fail on new bounds Postgres cannot order
statement ok
CREATE TABLE lit.dt (d DATE)

statement ok
INSERT INTO lit.dt VALUES (DATE '2020-01-01')

statement ok
SET ducklake_debug_relative_commit = true

statement error
INSERT INTO lit.dt VALUES (DATE '5874898-01-01')
----
<REGEX>:.*DuckLake relative commit fell back unexpectedly: incomparable new min bound of table 2.*

# an unusable fallback function commits absolutely
statement ok
CALL postgres_execute('pg', 'DROP FUNCTION parity_lit.ducklake_commit_fallback_v1(text)')

statement ok
CALL enable_logging(level => 'debug')

statement ok
INSERT INTO lit.t VALUES ('d')

statement ok
CALL disable_logging()

statement ok
SET ducklake_debug_relative_commit = false

query I
SELECT count(*) FROM duckdb_logs
WHERE message = 'DuckLake relative commit fell back: PL/pgSQL or its fallback function is not usable'
----
1

query I
SELECT count(*) FROM duckdb_logs WHERE type = 'PostgresQueryLog' AND message LIKE '%DO $dlrel$%'
AND message LIKE '%parity_lit%'
----
0

query I
SELECT count(*) FROM lit.t WHERE s = 'd'
----
1

foreach lake rel abs lit fn off

statement ok
DETACH {lake}

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA parity_{lake} CASCADE')

endloop
