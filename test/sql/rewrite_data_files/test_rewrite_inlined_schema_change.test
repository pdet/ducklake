# name: test/sql/rewrite_data_files/test_rewrite_inlined_schema_change.test
# description: rewrite_data_files with inlined data written before and after a schema change
# group: [rewrite_data_files]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/rewrite_alter', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (id INTEGER, v INTEGER)

statement ok
INSERT INTO dl.t SELECT i, i FROM range(20) r(i)

statement ok
INSERT INTO dl.t VALUES (1000, 1)

statement ok
ALTER TABLE dl.t ADD COLUMN w INTEGER

statement ok
INSERT INTO dl.t VALUES (2000, 2, 7)

statement ok
DELETE FROM dl.t WHERE id = 5

query II
SELECT files_processed, files_created FROM ducklake_rewrite_data_files('dl', 't', delete_threshold => 0)
----
1	1

query IIII
SELECT count(*), sum(id), sum(v), sum(w) FROM dl.t
----
21	3185	188	7

# swap two column names, so the older inlined table has both names for other columns
statement ok
CREATE TABLE dl.s (a INTEGER, b INTEGER)

statement ok
INSERT INTO dl.s SELECT i, i FROM range(20) r(i)

statement ok
INSERT INTO dl.s VALUES (1000, 1)

statement ok
BEGIN

statement ok
ALTER TABLE dl.s RENAME a TO c

statement ok
ALTER TABLE dl.s RENAME b TO a

statement ok
ALTER TABLE dl.s RENAME c TO b

statement ok
COMMIT

statement ok
INSERT INTO dl.s VALUES (2, 3)

statement ok
DELETE FROM dl.s WHERE b = 5

query II
SELECT files_processed, files_created FROM ducklake_rewrite_data_files('dl', 's', delete_threshold => 0)
----
1	1

query II
SELECT b, a FROM dl.s WHERE b = 1000
----
1000	1

query II
SELECT max(b), max(a) FROM dl.s
----
1000	19
