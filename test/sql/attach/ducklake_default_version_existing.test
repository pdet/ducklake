# name: test/sql/attach/ducklake_default_version_existing.test
# description: ducklake_default_version applies to new catalogs only, existing catalogs keep their own version
# group: [attach]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/ducklake_default_version_existing.db

test-env DATA_PATH {TEST_DIR}

statement ok
SET ducklake_default_version = '1.0'

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/ducklake_default_version_existing')

query I
SELECT value FROM __ducklake_metadata_dl.ducklake_metadata WHERE key = 'version'
----
1.0

statement ok
CREATE TABLE dl.t(i INTEGER);

statement ok
INSERT INTO dl.t VALUES (1);

statement ok
DETACH dl

# a 1.0 catalog attaches without a migration while the default is 1.1-dev1
statement ok
SET ducklake_default_version = '1.1-dev1'

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl

query I
SELECT value FROM __ducklake_metadata_dl.ducklake_metadata WHERE key = 'version'
----
1.0

statement ok
INSERT INTO dl.t VALUES (2);

statement ok
DETACH dl

# AUTOMATIC_MIGRATION migrates to the latest version while the default is 1.0
statement ok
SET ducklake_default_version = '1.0'

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (AUTOMATIC_MIGRATION TRUE)

query I
SELECT value FROM __ducklake_metadata_dl.ducklake_metadata WHERE key = 'version'
----
1.1-dev1

statement ok
DETACH dl

# a 1.1-dev1 catalog attaches while the default is 1.0
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl

query I
SELECT value FROM __ducklake_metadata_dl.ducklake_metadata WHERE key = 'version'
----
1.1-dev1

statement ok
INSERT INTO dl.t VALUES (3);

query I
SELECT i FROM dl.t ORDER BY i
----
1
2
3

statement ok
DETACH dl

# an explicit DUCKLAKE_VERSION still pins the version of an existing catalog
statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DUCKLAKE_VERSION '1.0')
----
Cannot downgrade

# so does a ducklake_version in a secret
statement ok
CREATE SECRET pinned_lake (TYPE DUCKLAKE, METADATA_PATH '{DUCKLAKE_CONNECTION}', DUCKLAKE_VERSION '1.0')

statement error
ATTACH 'ducklake:pinned_lake' AS dl
----
Cannot downgrade
