# name: test/sql/attach/ducklake_main_database.test
# description: A DuckLake can be opened as the main database
# group: [attach]

require ducklake

require parquet

statement ok
ATTACH 'ducklake:{TEST_DIR}/ducklake_main_database.ducklake' AS lake

statement ok
CREATE TABLE lake.t AS SELECT 42 AS i

statement ok
DETACH lake

# FIXME: opening a DuckLake as the main database fails with "database with name ... already exists", see https://github.com/pdet/ducklake_internal/issues/115
mode skip

load ducklake:{TEST_DIR}/ducklake_main_database.ducklake

query I
FROM t
----
42

statement ok
INSERT INTO t VALUES (43)

query II
SELECT database_name, type FROM duckdb_databases() WHERE NOT internal ORDER BY ALL
----
ducklake_main_database	ducklake

restart

query I
FROM t ORDER BY i
----
42
43

mode unskip
