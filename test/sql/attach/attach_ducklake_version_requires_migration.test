# name: test/sql/attach/attach_ducklake_version_requires_migration.test
# description: Requesting a newer DUCKLAKE_VERSION than the catalog requires AUTOMATIC_MIGRATION
# group: [attach]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

foreach name,version dev,1.1-dev1 final,1.1

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_version_requires_migration_{name}', METADATA_SCHEMA 'requires_migration_{name}', DUCKLAKE_VERSION '1.0')

statement ok
CREATE TABLE ducklake.t AS SELECT 42 AS i

statement ok
DETACH ducklake

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_version_requires_migration_{name}', METADATA_SCHEMA 'requires_migration_{name}', DUCKLAKE_VERSION '{version}')
----
DuckLake catalog version mismatch: catalog version is 1.0, but the extension requires version 1.1

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_version_requires_migration_{name}', METADATA_SCHEMA 'requires_migration_{name}', DUCKLAKE_VERSION '{version}', AUTOMATIC_MIGRATION TRUE)

query I
FROM ducklake.t
----
42

query I
SELECT value = '{version}' FROM ducklake.options() WHERE option_name = 'version'
----
true

statement ok
DETACH ducklake

endloop
