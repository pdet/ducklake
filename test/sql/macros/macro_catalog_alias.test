# name: test/sql/macros/macro_catalog_alias.test
# description: A macro that names its own catalog keeps working when the lake is attached under another name
# group: [macros]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/macro_catalog_alias.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/macro_catalog_alias', METADATA_CATALOG 'macro_catalog_alias_meta', DUCKLAKE_VERSION '1.1-dev1')

statement ok
CREATE TABLE dl.main.t AS SELECT 42 AS x

statement ok
CREATE SCHEMA dl.s

statement ok
CREATE SCHEMA dl.s.nested

statement ok
CREATE TABLE dl.s.nested.t AS SELECT 7 AS x

statement ok
CREATE TABLE memory.main.t AS SELECT -1 AS x

statement ok
CREATE MACRO dl.scalar_m() AS (SELECT max(x) FROM dl.main.t)

statement ok
CREATE MACRO dl.two_part_m() AS (SELECT max(x) FROM DL.t)

statement ok
CREATE MACRO dl.nested_m() AS (SELECT max(x) FROM dl.s.nested.t)

statement ok
CREATE MACRO dl.table_m() AS TABLE SELECT x FROM dl.main.t

statement ok
CREATE MACRO dl.calls_m(i) AS dl.main.scalar_m() + i

statement ok
CREATE MACRO dl.calls_table_m() AS TABLE SELECT x + 1 AS x FROM dl.main.table_m()

statement ok
CREATE MACRO dl.first_version() AS 1

statement ok
CREATE MACRO dl.total(v) AS sum(v)

statement ok
CREATE MACRO dl.dist(a, b) AS abs(a - b)

statement ok
CREATE MACRO dl.column_m() AS (SELECT max(dl.main.t.x) + max(dl.t.x) FROM dl.main.t)

statement ok
CREATE MACRO dl.window_m() AS TABLE SELECT dl.main.total(x) OVER () AS y FROM dl.main.t

statement ok
CREATE MACRO dl.at_m() AS (SELECT max(x) FROM dl.main.t AT (VERSION => dl.main.first_version()))

statement ok
CREATE MACRO dl.nearest_m() AS TABLE SELECT q.x FROM dl.main.t q INNER JOIN dl.main.t r EXACT NEAREST 1 BY DISTANCE dl.main.dist(q.x, r.x)

statement ok
CREATE MACRO dl.row_m() AS TABLE SELECT dl.t AS r FROM dl.main.t

statement ok
CREATE MACRO dl.star_m() AS TABLE SELECT * EXCLUDE (dl.main.t.x), * RENAME (dl.main.t.x AS y) FROM dl.main.t

statement ok
CREATE MACRO dl.struct_alias_m() AS (SELECT dl.s.x FROM (SELECT {'x': 42} AS s) dl)

# a table alias or a string that reads like the catalog is not a reference to it, and other catalogs keep their name
statement ok
CREATE MACRO dl.untouched_m() AS (SELECT 'dl.main.t:' || dl.x || ':' || (SELECT max(x) FROM memory.main.t) FROM dl.main.t AS dl)

query T
SELECT sql FROM macro_catalog_alias_meta.ducklake_macro_impl ORDER BY macro_id
----
(SELECT max(x) FROM "{DUCKLAKE_CATALOG}".main.t)
(SELECT max(x) FROM "{DUCKLAKE_CATALOG}".t)
(SELECT max(x) FROM "{DUCKLAKE_CATALOG}".s.nested.t)
SELECT x FROM "{DUCKLAKE_CATALOG}".main.t
("{DUCKLAKE_CATALOG}".main.scalar_m() + i)
SELECT (x + 1) AS x FROM "{DUCKLAKE_CATALOG}".main.table_m()
1
sum(v)
abs((a - b))
(SELECT (max("{DUCKLAKE_CATALOG}".main.t.x) + max("{DUCKLAKE_CATALOG}".t.x)) FROM "{DUCKLAKE_CATALOG}".main.t)
SELECT "{DUCKLAKE_CATALOG}".main.total(x) OVER () AS y FROM "{DUCKLAKE_CATALOG}".main.t
(SELECT max(x) FROM "{DUCKLAKE_CATALOG}".main.t AT (VERSION => "{DUCKLAKE_CATALOG}".main.first_version()))
SELECT q.x FROM ("{DUCKLAKE_CATALOG}".main.t AS q INNER JOIN "{DUCKLAKE_CATALOG}".main.t AS r EXACT NEAREST 1 BY DISTANCE "{DUCKLAKE_CATALOG}".main.dist(q.x, r.x))
SELECT "{DUCKLAKE_CATALOG}".t AS r FROM "{DUCKLAKE_CATALOG}".main.t
SELECT * EXCLUDE ("{DUCKLAKE_CATALOG}".main.t.x), * RENAME ("{DUCKLAKE_CATALOG}".main.t.x AS y) FROM "{DUCKLAKE_CATALOG}".main.t
(SELECT dl.s.x FROM (SELECT struct_pack(x := 42) AS s) AS dl)
(SELECT ((('dl.main.t:' || dl.x) || ':') || (SELECT max(x) FROM memory.main.t)) FROM "{DUCKLAKE_CATALOG}".main.t AS dl)

statement ok
DETACH dl

# a schema of the default database named like the new alias does not make the references ambiguous
statement ok
CREATE SCHEMA memory.other

statement ok
CREATE TABLE memory.other.t AS SELECT -5 AS x

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS other (DATA_PATH '{DATA_PATH}/macro_catalog_alias', DUCKLAKE_VERSION '1.1-dev1')

query IIIIII
SELECT other.main.scalar_m(), other.main.two_part_m(), other.main.nested_m(), other.main.calls_m(1), other.main.column_m(), other.main.at_m()
----
42	42	7	43	84	42

query III
SELECT (SELECT x FROM other.main.table_m()), (SELECT x FROM other.main.calls_table_m()), (SELECT y FROM other.main.window_m())
----
42	43	42

query I
SELECT x FROM other.main.nearest_m()
----
42

query TII
SELECT (SELECT r FROM other.main.row_m()), (SELECT y FROM other.main.star_m()), other.main.struct_alias_m()
----
{'x': 42}	42	42

query T
SELECT other.main.untouched_m()
----
dl.main.t:42:-1
