# name: test/sql/macros/nested_default_legacy.test
# description: macros with nested defaults written by DuckLake 1.0 load without their default
# group: [macros]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/ducklake_macro_nested_default_legacy.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/macro_nested_default_legacy', METADATA_CATALOG 'ducklake_meta')

statement ok
CREATE MACRO ducklake.list_default(x := 0) AS x

statement ok
CREATE MACRO ducklake.map_default(x := 0) AS x

statement ok
CREATE MACRO ducklake.struct_default(x := 0) AS x

# Legacy nested defaults omit child types
query I
UPDATE ducklake_meta.ducklake_macro_parameters SET default_value = '[2020-01-01]', default_value_type = 'list' WHERE macro_id = (SELECT macro_id FROM ducklake_meta.ducklake_macro WHERE macro_name = 'list_default')
----
1

query I
UPDATE ducklake_meta.ducklake_macro_parameters SET default_value = '{a: 1}', default_value_type = 'struct' WHERE macro_id = (SELECT macro_id FROM ducklake_meta.ducklake_macro WHERE macro_name = 'struct_default')
----
1

query I
UPDATE ducklake_meta.ducklake_macro_parameters SET default_value = '{a=1}', default_value_type = 'map' WHERE macro_id = (SELECT macro_id FROM ducklake_meta.ducklake_macro WHERE macro_name = 'map_default')
----
1

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/macro_nested_default_legacy', METADATA_CATALOG 'ducklake_meta')

statement error
SELECT ducklake.list_default()
----
does not support the supplied arguments

query I
SELECT ducklake.list_default(42)
----
42

statement error
SELECT ducklake.map_default()
----
does not support the supplied arguments

statement error
SELECT ducklake.struct_default()
----
does not support the supplied arguments

query II
SELECT ducklake.map_default(42), ducklake.struct_default(42)
----
42	42

statement ok
DROP MACRO ducklake.map_default
