# name: test/sql/macros/macro_catalog_alias_v10.test
# description: The macros of a catalog written by DuckLake 1.0 keep their catalog name, also after the migration
# group: [macros]

require ducklake

require parquet

unzip data/old_ducklake/macro_alias_v10.db.gz {TEST_DIR}/macro_alias_v10.db

statement ok
ATTACH 'ducklake:{TEST_DIR}/macro_alias_v10.db' AS dl (DATA_PATH '{TEST_DIR}/macro_alias_v10_data', OVERRIDE_DATA_PATH TRUE, DUCKLAKE_VERSION '1.0')

query II
SELECT dl.m(), (SELECT x FROM dl.tm())
----
42	42

# a 1.0 catalog keeps the catalog name, as 1.0 readers cannot resolve the placeholder
statement ok
CREATE MACRO dl.m_new() AS (SELECT max(x) + 1 FROM dl.main.t)

query T
SELECT sql FROM __ducklake_metadata_dl.ducklake_macro_impl ORDER BY macro_id
----
(SELECT max(x) FROM dl.main.t)
SELECT * FROM dl.main.t
(SELECT (max(x) + 1) FROM dl.main.t)

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{TEST_DIR}/macro_alias_v10.db' AS dl (DATA_PATH '{TEST_DIR}/macro_alias_v10_data', OVERRIDE_DATA_PATH TRUE, AUTOMATIC_MIGRATION TRUE, DUCKLAKE_VERSION '1.1-dev1')

statement ok
CREATE MACRO dl.m_migrated() AS (SELECT max(x) + 2 FROM dl.main.t)

query III
SELECT dl.m(), dl.m_new(), dl.m_migrated()
----
42	43	44

query T
SELECT sql FROM __ducklake_metadata_dl.ducklake_macro_impl ORDER BY macro_id
----
(SELECT max(x) FROM dl.main.t)
SELECT * FROM dl.main.t
(SELECT (max(x) + 1) FROM dl.main.t)
(SELECT (max(x) + 2) FROM "{DUCKLAKE_CATALOG}".main.t)
