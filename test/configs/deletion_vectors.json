{
  "description": "Run DuckLake tests with deletion vectors enabled (puffin format instead of parquet delete files).",
  "on_init": "SET ducklake_write_deletion_vectors = true;",
  "statically_loaded_extensions": [
    "core_functions",
    "parquet",
    "ducklake",
    "icu"
  ],
  "skip_tests": [
    {
      "reason": "Parquet is statically loaded in this config, test requires missing parquet",
      "paths": [
        "test/sql/general/missing_parquet.test"
      ]
    },
    {
      "reason": "Statically loading ICU changes timezone rendering from +00 to local timezone offset",
      "paths": [
        "test/sql/alter/alter_timestamptz_promotion.test",
        "test/sql/alter/test_insert_select_alter_column_persistence.test"
      ]
    },
    {
      "reason": "Deletion inlining is disabled when write_deletion_vectors is enabled to avoid mixed format issues",
      "paths": [
        "test/sql/deletion_inlining/test_deletion_inlining.test",
        "test/sql/deletion_inlining/test_deletion_inlining_compaction.test",
        "test/sql/deletion_inlining/test_deletion_inlining_large.test",
        "test/sql/deletion_inlining/test_deletion_inlining_partitions.test",
        "test/sql/deletion_inlining/test_deletion_inlining_stats.test",
        "test/sql/deletion_inlining/test_deletion_inlining_table_deletes.test",
        "test/sql/deletion_inlining/test_deletion_inlining_transaction.test",
        "test/sql/deletion_inlining/test_deletion_from_file_and_inserted_inlining.test",
        "test/sql/deletion_inlining/test_deletion_from_file_and_inserted_inlining_non_sequential.test",
        "test/sql/data_inlining/data_inlining_update_inline_verification.test",
        "test/sql/delete/test_delete_partial_max_snapshot.test",
        "test/sql/table_changes/ducklake_table_deletions_inlined_flush.test"
      ]
    }
  ]
}
